@model ArticleViewModel

@{
    string navigationBlock = "d-flex align-items-center maxwidth700px p-2 my-2 mx-auto bg-success-subtle bg-opacity-10 block-shadow d-print-none";

    var caption = Model.BookOrArticle.CaptionOfText.SpaceToDash();

    string previewImageClass = "border border-secondary rounded max-width-40-60";

    string audioPreviewClass = Model.BookOrArticle.RefToAudio == null
        ? $"d-none {previewImageClass}"
        : previewImageClass;

    var hasAudioPlayer = !string.IsNullOrEmpty(
        Model.TextForBookOrArticle?.AudioInfoModel?.PlayerPodsterFm);

    string goToNextPage = "btn btn-outline-dark py-1 block-shadow";

    var hasPictures = Model.ListOfPictures is { Count: > 0 };

    string contentSize = string.Empty; // размер аудиофайла в мегабайтах

    string uploadDate = string.Empty; // дата загрузки аудиофайла

    if (Model.AudioFileForText != null)
    {
        contentSize = ((double)Model.AudioFileForText.AudioFileSize / (double)1048576).ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

        uploadDate = Model.AudioFileForText.AudioFileUploadDate.ToString("yyyy-MM-dd");
    }

    var picturesPreview = Model.PageNumber != 0 && Model.ListOfPictures is { Count: > 0 }
        ? Model.ListOfPictures
            .OrderBy(_ => Random.Shared.Next())
            .Take(4)
            .ToList()
        : new List<ImageFileModel>();
}

<div id="viewForBookPage" class="mx-auto fluid-font-size" itemscope itemtype="https://schema.org/Book">

    <partial name="_BookSchemaOrgPartial"
             model="Model.BookOrArticle" />
    @* Страница *@
    <div id="mainBlockForAudioBook" class="row gx-2 justify-content-center py-3 bg-secondary-subtle bg-opacity-25 block-shadow">

        @* Кадры слева *@
        <div id="picturesFromLeft" class="d-none d-lg-flex col-lg-2 flex-column">

            @if (Model.FramesAroundMainContent?.FramesOnTheLeft != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheLeft)
                {
                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@caption"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="block-shadow imageref"
                                       icon-type="webicon200" />
                    </a>
                }
            }

        </div>

        @* Заголовок аудиокниги и аудиоплеер*@
        <div id="blockForAllOptions" class="col-12 col-lg-8 pb-3">

            @* Заголовок аудиокниги *@
            <header class="lay1 p-2 my-3 mx-auto lh-1 times-new-roman maxwidth700px">

                <p class="fs-2 fw-bold mb-2 h1_print">

                    @Model.BookOrArticle.AuthorOfText

                </p>

                <h1 class="fs-2 fw-bold mb-2" itemprop="headline">

                    «@Model.BookOrArticle.CaptionOfText»

                </h1>

                <p class="fs-5 mt-3 text_shadow mb-0">

                    АУДИОКНИГА

                </p>

            </header>

            @* Аудиоплейер *@
            <div class="row mb-3 mx-0" itemscope itemtype="http://schema.org/AudioBook">

                <meta itemprop="name" content="@Model.BookOrArticle.CaptionOfText">
                <meta itemprop="author" content="@Model.BookOrArticle.AuthorOfText">
                <meta itemprop="description" content="@Model.BookOrArticle.BookDescription">
                @if (Model.AudioBook != null)
                {
                    <meta itemprop="readBy" content="@Model.AudioBook.ActorOfAudioBook">
                }
                @* <meta itemprop="contentUrl" content="">
            <meta itemprop="duration" content=""> *@

                @* Аудиоплейер и инфо под плеером *@

                <div class="col-12 mx-auto pb-2 block-shadow">

                    @* Аудиоплейер *@
                    <div class="times-new-roman" itemprop="audio" itemscope itemtype="http://schema.org/AudioObject">

                        <span>
                            @if (Model.AudioFileForText != null)
                            {
                                <meta itemprop="author" content="@Model.BookOrArticle.AuthorOfText">
                                <meta itemprop="name" content="@Model.BookOrArticle.CaptionOfText - @Model.AudioFileForText.CaptionOfTextInAudioFile">
                                @if (Model.Transcript != null)
                                {
                                    <meta itemprop="transcript" content="@Model.Transcript">
                                }
                                <meta itemprop="duration" content="@Model.AudioFileForText.AudioFileDuration.ToString(@"\Thh\Mmm\Sss")">
                                <meta itemprop="bitrate" content="@Model.AudioFileForText.AudioFileBitRate kbps">
                                <meta itemprop="contentSize" content="@contentSize MB">
                                <meta itemprop="encodingFormat" content="@Model.AudioFileForText.AudioFileMimeType" />
                                <meta itemprop="uploadDate" content="@uploadDate">
                                <meta itemprop="description" content="@Model.AudioFileForText.AudioFileDescription">
                                <link itemprop="contentUrl" href="@Model.AudioFileForText.InternetRefToAudioFile">
                            }
                        </span>

                        @if (Model.AudioFileForText != null)
                        {
                            <p class="fs-2 text-center fw-bold">@Model.AudioFileForText.CaptionOfTextInAudioFile</p>

                            <div class="d-none d-sm-flex mt-4">

                                @Html.Raw(Model.AudioFileForText.PlayerPodsterFm)

                            </div>

                            <p class="d-sm-none fs-6 text_shadow">
                                <span>Аудиоплейер не отображается при низком разрешении экрана</span>
                                <br />
                                <span> (меньше 576px)</span>
                            </p>
                        }
                        else
                        {
                            <p class="text-danger">АУДИОФАЙЛ НЕ НАЙДЕН</p>
                        }

                    </div>

                    @* Инфо внизу страницы *@
                    <footer class="d-flex mt-4 footer_page align-items-center d-print-none">

                        @* Иконка TXT *@
                        <a class="@(Model.TextForBookOrArticle == null ? "d-none" : "me-2")"
                           asp-area=""
                           asp-controller="Books"
                           asp-action="Book"
                           asp-route-bookCaption="@Model.BookOrArticle.CaptionOfText.SpaceToDash()"
                           asp-route-pageNumber="@Model.TextForBookOrArticle?.SequenceNumber"
                           title="текст аудиокниги">

                            <vc:view-image image-id="@DataConfig.TxtImage"
                                           css-class="max-width-40-60 block-shadow imageref d-print-none"
                                           icon-type="webicon100" />

                        </a>

                        @* Иконка MP3 *@
                        <a class="@(Model.AudioFileForText == null ? "d-none" : "me-2")"
                           href="@Model.AudioFileForText?.InternetRefToAudioFile"
                           title="файл MP3"
                           onclick="this.target='_blank'">

                            <vc:view-image image-id="@DataConfig.Mp3Image"
                                           css-class="max-width-40-60 block-shadow imageref d-print-none"
                                           icon-type="webicon100" />

                        </a>

                        @* Иконка фильма *@
                        @if (Model.BookOrArticle.FilmForBookOrArticle != null)
                        {
                            <a class=""
                               asp-area=""
                               asp-controller="Films"
                               asp-action="Film"
                               asp-route-filmCaption="@Model.BookOrArticle.FilmForBookOrArticle.FilmCaption"
                               asp-route-host="@Model.BookOrArticle.FilmForBookOrArticle?.FilmContentUrl"
                               title="видео к тексту">

                                <vc:view-image image-id="@DataConfig.ImageForFilm"
                                               css-class="max-width-40-60 block-shadow imageref d-print-none"
                                               icon-type="webicon100" />

                            </a>
                        }

                        @* Номер страницы *@
                        <p class="col-width-content ms-auto text-primary fw-bold charst fluid-font-size @(Model.PageNumber == 0 ? "d-none" : "")">

                            @if (Model.AudioFileForText != null)
                            {
                                @Model.AudioFileForText.SequenceNumber
                            }

                        </p>

                    </footer>

                </div>

            </div>

            @* Навигация Следующая и Предыдущая страницы *@
            <div id="pageNavigation" class="@(Model.PageNumber == 0 ? "d-none" : $"{navigationBlock}")">

                @* Переход к предыдущей странице*@
                <a class="@((Model.AudioFileForText?.SequenceNumber > 1) ? $"{goToNextPage}" : "d-none")"
                   asp-area=""
                   asp-controller="Books"
                   asp-action="AudioBook"
                   asp-route-audioBookCaption="@Model.BookOrArticle.CaptionOfText.SpaceToDash()"
                   asp-route-audioActor="@(Model.AudioBook?.ActorOfAudioBook)"
                   asp-route-audioBookPart="@(Model.AudioFileForText?.SequenceNumber - 1)"
                   title="предыдущая часть"
                   itemprop="url">

                    <span class="charst fluid-font-size">
                        @(Model.AudioFileForText?.SequenceNumber - 1)
                    </span>

                </a>

                @* Переход к следующей странице*@
                <a class="@((Model.AudioFileForText?.SequenceNumber < Model.AudioBook?.NumberOfFiles) ? $"{goToNextPage} ms-auto" : "d-none")"
                   asp-area=""
                   asp-controller="Books"
                   asp-action="AudioBook"
                   asp-route-audioBookCaption="@Model.BookOrArticle.CaptionOfText.SpaceToDash()"
                   asp-route-audioActor="@(Model.AudioBook?.ActorOfAudioBook)"
                   asp-route-audioBookPart="@(Model.AudioFileForText?.SequenceNumber + 1)"
                   title="следующая часть"
                   itemprop="url">

                    <span class="charst fluid-font-size">
                        @(Model.AudioFileForText?.SequenceNumber + 1)
                    </span>

                </a>

            </div>

            @* Раскрывающиеся поля *@
            <div class="@(Model.PageNumber == 0 ? "d-none" : "") mx-auto px-2 py-1 mt-3 bg-primary-subtle bg-opacity-10 maxwidth700px block-shadow">

                <div id="accordionForBook" class="@(Model.PageNumber == 0 ? "d-none" : "accordion maxwidth700px d-print-none")">

                    @* Страницы книги *@
                    <div id="bookPagesAccordionItem" class="accordion-item my-3 block-shadow">

                        @* Заголовок группы «страницы книги» *@
                        <h2 id="headingPagesOfBook" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#PagesOfBook"
                                    aria-expanded="false"
                                    aria-controls="PagesOfBook">

                                <span class="d-flex pb-1">
                                    Страницы книги :
                                </span>

                            </button>

                        </h2>

                        <div id="PagesOfBook"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingPagesOfBook"
                             data-bs-parent="#accordionForBook">

                            <div id="bookPagesAccordionBody" class="accordion-body text-indent-0 text-center px-1">

                                @for (int i = 0; i < Model.BookOrArticle.NumberOfPages; i++)
                                {
                                    <a asp-area=""
                                       asp-controller="Books"
                                       asp-action="Book"
                                       asp-route-bookCaption="@caption"
                                       asp-route-pagenumber="@(i + 1)"
                                       class="ref-to-page rounded ten @(Model.PageNumber == (i + 1) ? "border border-primary border-2" : "border border-1 border-secondary")"
                                       title="Страница @(i + 1)">

                                        @(i + 1)

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                    @* Скачать книгу *@
                    <div id="downloadBookAccordionItem" class="accordion-item my-3 block-shadow">

                        @* Заголовок группы «скачать книгу» *@
                        <h2 id="headingLoadBook" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-2 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#LoadBook"
                                    aria-expanded="false"
                                    aria-controls="LoadBook">

                                @* Картинки на кнопке аккордеона *@
                                <div class="ps-0">

                                    <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                        <span class="d-none d-sm-block me-2 text-start">
                                            Скачать книгу :
                                        </span>

                                        @* Word *@
                                        <vc:view-image image-id="@DataConfig.WordImage"
                                                       css-class="@previewImageClass"
                                                       icon-type="webicon100" />

                                        @* Pdf *@
                                        <vc:view-image image-id="@DataConfig.PdfImage"
                                                       css-class="@previewImageClass"
                                                       icon-type="webicon100" />

                                        @* Audio *@
                                        <vc:view-image image-id="@DataConfig.AudioImage"
                                                       css-class="@audioPreviewClass"
                                                       icon-type="webicon100" />

                                    </div>

                                </div>

                            </button>

                        </h2>

                        <div id="LoadBook"
                             class="accordion-collapse collapse p-2"
                             aria-labelledby="headingLoadBook"
                             data-bs-parent="#accordionForBook">

                            <div id="downloadBookAccordionBody" class="accordion-body text-indent-0">

                                <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                    @* Текст в формате word *@
                                    <a class="@(Model.BookOrArticle.RefToWordDoc == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToWordDoc"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать в формате Word"
                                       aria-label="Скачать в формате Word">

                                        <vc:view-image image-id="@DataConfig.WordImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300" />
                                    </a>

                                    @* Текст в формате pdf *@
                                    <a class="@(Model.BookOrArticle.RefToPdf == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToPdf"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать в формате Pdf"
                                       aria-label="Скачать в формате Pdf">

                                        <vc:view-image image-id="@DataConfig.PdfImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* Аудиокнига *@
                                    <a class="@(Model.BookOrArticle.RefToAudio == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToAudio"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать аудиокнигу"
                                       aria-label="Скачать аудиокнигу">

                                        <vc:view-image image-id="@DataConfig.AudioImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Фото из книги *@
                    <div id="photoFromBookAccordionItem" class="@(hasPictures ? "accordion-item my-3 block-shadow" : "d-none")">

                        @* Заголовок группы «фото из книги» *@
                        <h2 id="headingPhoto" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-2 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#Photo"
                                    aria-expanded="false"
                                    aria-controls="Photo">

                                @* Картинки на кнопке аккордеона *@
                                <div class="ps-0">

                                    <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                        <span class="d-none d-sm-block me-2">
                                            Фото из книги :
                                        </span>

                                        @foreach (var pic in picturesPreview)
                                        {
                                            <vc:view-image image-id="@pic.ImageFileModelId"
                                                           css-class="@previewImageClass"
                                                           icon-type="webicon100" />
                                        }

                                    </div>

                                </div>

                            </button>

                        </h2>

                        <div id="Photo"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingPhoto"
                             data-bs-parent="#accordionForBook">

                            <div id="photoFromBookAccordionBody" class="accordion-body text-indent-0 py-2">

                                <div class="row row-cols-2 row-cols-sm-4 row-cols-md-5 row-cols-lg-6 g-2 pb-2 justify-content-center">

                                    @if (Model.ListOfPictures != null)
                                    {

                                        @foreach (var item in Model.ListOfPictures)
                                        {
                                            <a asp-area=""
                                               asp-controller="Books"
                                               asp-action="PhotoAlbum"
                                               asp-route-albumCaption="@caption"
                                               asp-route-imageId="@item.ImageFileModelId"
                                               class="col rounded-3 text-center">

                                                <vc:view-image image-id="@item.ImageFileModelId.ToString()"
                                                               css-class="rounded-3 block-shadow imageref"
                                                               icon-type="webicon100" />
                                            </a>
                                        }
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        @* Кадры справа *@
        <div id="picturesFromRight" class="d-none d-lg-flex col-lg-2 flex-column">

            @if (Model.FramesAroundMainContent != null && Model.FramesAroundMainContent.FramesOnTheRight != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheRight)
                {
                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@caption"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="block-shadow imageref"
                                       icon-type="webicon200" />
                    </a>
                }
            }

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/sync-heights.js" asp-append-version="true"></script>
}