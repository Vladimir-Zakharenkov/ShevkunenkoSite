@model ArticleViewModel

@{
    var isCover = Model.PageNumber == 0;

    var caption = Model.BookOrArticle.CaptionOfText.SpaceToDash();

    string navigationBlock = "d-flex align-items-center maxwidth700px w-100 p-2 mt-3 mx-auto bg-light-subtle block-shadow d-print-none";

    string goToNextPage = "btn btn-outline-dark py-0 block-shadow";

    var hasPictures = Model.ListOfPictures is { Count: > 0 };

    string previewImageClass = "border border-secondary rounded max-width-40-60";

    var picturesPreview = Model.PageNumber != 0 && Model.ListOfPictures is { Count: > 0 }
        ? Model.ListOfPictures
            .OrderBy(_ => Random.Shared.Next())
            .Take(4)
            .ToList()
        : new List<ImageFileModel>();

    var hasAudioPlayer = !string.IsNullOrEmpty(
            Model.TextForBookOrArticle?.AudioInfoModel?.PlayerPodsterFm);

    string audioPreviewClass = Model.BookOrArticle.RefToAudio == null
        ? $"d-none {previewImageClass}"
        : previewImageClass;
}

<div id="viewForBookPage" class="mx-auto fluid-font-size" itemscope itemtype="https://schema.org/Book">

    <partial name="_BookSchemaOrgPartial"
             model="Model.BookOrArticle" />

    @* Страница *@
    <div id="mainBlockForBookPage" class="row gx-2 justify-content-center py-3 bg-secondary-subtle bg-opacity-25 block-shadow">

        @* Кадры слева *@
        <div id="picturesFromLeft" class="d-none d-lg-flex col-lg-2 flex-column">

            @if (Model.FramesAroundMainContent?.FramesOnTheLeft != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheLeft)
                {
                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@caption"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="block-shadow imageref"
                                       icon-type="webicon200AI" />
                    </a>
                }
            }

        </div>

        @* Заголовок книги и текст страницы*@
        <div id="blockForAllOptions" class="col-12 col-lg-8 pb-3">

            @* Заголовок книги *@
            <header class="lay1 p-2 my-3 mx-auto lh-1 times-new-roman maxwidth700px">

                <p class="fs-2 fw-bold mb-2 h1_print">

                    @Model.BookOrArticle.AuthorOfText

                </p>

                <h1 class="fs-2 fw-bold mb-2" itemprop="headline">

                    «@Model.BookOrArticle.CaptionOfText»

                </h1>

                @if (isCover)
                {
                    <p class="fs-5 mt-3 text_shadow mb-0">

                        @Model.BookOrArticle.TheSubtitle

                    </p>
                }

            </header>

            @* Текст страницы *@
            <div class="article_page mx-auto paragraph block-shadow
                @(isCover ? "px-0 px-sm-2 px-md-3" : "")">

                @* Инфо вверху страницы *@
                <partial name="_PageToolsTopPartial" model="Model" />

                @* Текст страницы *@
                <div class="page-min-height times-new-roman" itemprop="text">

                    @Html.Raw(Model.HtmlText)

                </div>

                @* Инфо внизу страницы *@
                <partial name="_PageToolsBottomPartial" model="Model" />

            </div>

            @* Навигация Следующая и Предыдущая страницы *@
            <div id="pageNavigation" class="@(Model.PageNumber == 0 ? "d-none" : $"{navigationBlock}")">

                @* Переход к предыдущей странице*@
                <a id="goPrev" class="@((Model.PageNumber > 1) ? $"{goToNextPage} me-3" : "d-none")"
                   asp-area=""
                   asp-controller="Books"
                   asp-action="Book"
                   asp-route-bookCaption="@caption"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   title="Предыдущая страница"
                   aria-label="Предыдущая страница">

                    <span class="nomstr fluid-font-size">
                        @(Model.PageNumber - 1)
                    </span>

                </a>

                @* Переход к следующей странице*@
                <a id="goNext" class="@((Model.PageNumber < Model.BookOrArticle.NumberOfPages) ? $"{goToNextPage} ms-auto" : "d-none")"
                   asp-area=""
                   asp-controller="Books"
                   asp-action="Book"
                   asp-route-bookCaption="@caption"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   title="Следующая страница"
                   aria-label="Следующая страница">

                    <span class="nomstr fluid-font-size">
                        @(Model.PageNumber + 1)
                    </span>

                </a>

            </div>

            @* Раскрывающиеся поля *@
            <div class="@(Model.PageNumber == 0 ? "d-none" : "") mx-auto px-2 py-1 mt-3 bg-primary-subtle bg-opacity-10 maxwidth700px block-shadow">

                <div id="accordionForBook" class="@(Model.PageNumber == 0 ? "d-none" : "accordion maxwidth700px d-print-none")">

                    @* Страницы книги *@
                    <div id="bookPagesAccordionItem" class="accordion-item my-3 block-shadow">

                        @* Заголовок группы «страницы книги» *@
                        <h2 id="headingPagesOfBook" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#PagesOfBook"
                                    aria-expanded="false"
                                    aria-controls="PagesOfBook">

                                <span class="d-flex pb-1">
                                    Страницы книги :
                                </span>

                            </button>

                        </h2>

                        <div id="PagesOfBook"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingPagesOfBook"
                             data-bs-parent="#accordionForBook">

                            <div id="bookPagesAccordionBody" class="accordion-body text-indent-0 text-center px-1">

                                @for (int i = 0; i < Model.BookOrArticle.NumberOfPages; i++)
                                {
                                    <a asp-area=""
                                       asp-controller="Books"
                                       asp-action="Book"
                                       asp-route-bookCaption="@caption"
                                       asp-route-pagenumber="@(i + 1)"
                                       class="ref-to-page rounded ten @(Model.PageNumber == (i + 1) ? "border border-primary border-2" : "border border-1 border-secondary")"
                                       title="Страница @(i + 1)">

                                        @(i + 1)

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                    @* Скачать книгу *@
                    <div id="downloadBookAccordionItem" class="accordion-item my-3 block-shadow">

                        @* Заголовок группы «скачать книгу» *@
                        <h2 id="headingLoadBook" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-2 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#LoadBook"
                                    aria-expanded="false"
                                    aria-controls="LoadBook">

                                @* Картинки на кнопке аккордеона *@
                                <div class="ps-0">

                                    <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                        <span class="d-none d-sm-block me-2 text-start">
                                            Скачать книгу :
                                        </span>

                                        @* Word *@
                                        <vc:view-image image-id="@DataConfig.WordImage"
                                                       css-class="@previewImageClass"
                                                       icon-type="webicon100AI" />

                                        @* Pdf *@
                                        <vc:view-image image-id="@DataConfig.PdfImage"
                                                       css-class="@previewImageClass"
                                                       icon-type="webicon100AI" />

                                        @* Audio *@
                                        <vc:view-image image-id="@DataConfig.AudioImage"
                                                       css-class="@audioPreviewClass"
                                                       icon-type="webicon100AI" />

                                    </div>

                                </div>

                            </button>

                        </h2>

                        <div id="LoadBook"
                             class="accordion-collapse collapse p-2"
                             aria-labelledby="headingLoadBook"
                             data-bs-parent="#accordionForBook">

                            <div id="downloadBookAccordionBody" class="accordion-body text-indent-0">

                                <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                    @* Текст в формате word *@
                                    <a class="@(Model.BookOrArticle.RefToWordDoc == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToWordDoc"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать в формате Word"
                                       aria-label="Скачать в формате Word">

                                        <vc:view-image image-id="@DataConfig.WordImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300AI" />
                                    </a>

                                    @* Текст в формате pdf *@
                                    <a class="@(Model.BookOrArticle.RefToPdf == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToPdf"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать в формате Pdf"
                                       aria-label="Скачать в формате Pdf">

                                        <vc:view-image image-id="@DataConfig.PdfImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300AI" />

                                    </a>

                                    @* Аудиокнига *@
                                    <a class="@(Model.BookOrArticle.RefToAudio == null ? "d-none" : "")"
                                       href="@Model.BookOrArticle.RefToAudio"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Скачать аудиокнигу"
                                       aria-label="Скачать аудиокнигу">

                                        <vc:view-image image-id="@DataConfig.AudioImage"
                                                       css-class="block-shadow imageref"
                                                       icon-type="webicon300AI" />

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Фото из книги *@
                    <div id="photoFromBookAccordionItem" class="@(hasPictures ? "accordion-item my-3 block-shadow" : "d-none")">

                        @* Заголовок группы «фото из книги» *@
                        <h2 id="headingPhoto" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-2 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#Photo"
                                    aria-expanded="false"
                                    aria-controls="Photo">

                                @* Картинки на кнопке аккордеона *@
                                <div class="ps-0">

                                    <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                        <span class="d-none d-sm-block me-2">
                                            Фото из книги :
                                        </span>

                                        @foreach (var pic in picturesPreview)
                                        {
                                            <vc:view-image image-id="@pic.ImageFileModelId"
                                                           css-class="@previewImageClass"
                                                           icon-type="webicon100AI" />
                                        }

                                    </div>

                                </div>

                            </button>

                        </h2>

                        <div id="Photo"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingPhoto"
                             data-bs-parent="#accordionForBook">

                            <div id="photoFromBookAccordionBody" class="accordion-body text-indent-0 py-2">

                                <div class="row row-cols-2 row-cols-sm-4 row-cols-md-5 row-cols-lg-6 g-2 pb-2 justify-content-center">

                                    @if (Model.ListOfPictures != null)
                                    {

                                        @foreach (var item in Model.ListOfPictures)
                                        {
                                            <a asp-area=""
                                               asp-controller="Books"
                                               asp-action="PhotoAlbum"
                                               asp-route-albumCaption="@caption"
                                               asp-route-imageId="@item.ImageFileModelId"
                                               class="col rounded-3 text-center">

                                                <vc:view-image image-id="@item.ImageFileModelId.ToString()"
                                                               css-class="rounded-3 block-shadow imageref"
                                                               icon-type="webicon100AI" />
                                            </a>
                                        }
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Аудио *@
                    <div class="@(hasAudioPlayer ? "accordion-item my-3 block-shadow" : "d-none")">

                        @* Заголовок группы «Аудио» *@
                        <h2 id="headingAudioForPage" class="accordion-header align-items-center block-shadow">

                            <button class="accordion-button collapsed py-2 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#AudioForPage"
                                    aria-expanded="false"
                                    aria-controls="AudioForPage">

                                <span class="d-inline-block w-100 fs-5">
                                    Аудиокнига :
                                </span>

                            </button>

                        </h2>

                        <div id="AudioForPage"
                             class="accordion-collapse collapse p-0"
                             aria-labelledby="headingAudioForPage"
                             data-bs-parent="#accordionForBook">

                            <div class="accordion-body text-indent-0">

                                <p class="d-sm-none my-2 text-center text_shadow ">
                                    плеер отображается при разрешении экрана от 576px
                                </p>

                                <div class="d-none d-sm-flex my-2 block-shadow rounded-3 bg-dark">

                                    @Html.Raw(Model.TextForBookOrArticle?.AudioInfoModel?.PlayerPodsterFm)

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        @* Кадры справа *@
        <div id="picturesFromRight" class="d-none d-lg-flex col-lg-2 flex-column">

            @if (Model.FramesAroundMainContent != null && Model.FramesAroundMainContent.FramesOnTheRight != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheRight)
                {
                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@caption"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="block-shadow imageref"
                                       icon-type="webicon200AI" />
                    </a>
                }
            }

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/sync-heights.js" asp-append-version="true"></script>
}