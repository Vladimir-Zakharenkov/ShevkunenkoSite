@model ArticleViewModel

@{
    int n = 0; // количество миниатюр фотографий
}

<div class="mx-auto fluid-font-size" itemscope itemtype="https://schema.org/Book">

    @* Данные для  https://schema.org/Book display:none *@
    <span class="d-none">

        <meta itemprop="author" content="@Model.BookOrArticle.AuthorOfText" />
        <meta itemprop="headline" content="@Model.BookOrArticle.CaptionOfText" />
        <meta itemprop="url" content="https://@Context.Request.Host@Context.Request.Path@Context.Request.QueryString">
        <meta itemprop="publisher" content="@Model.BookOrArticle.Publisher">
        <meta itemprop="dateModified datePublished dateModified" content="@Model.BookOrArticle.DateOfPublication.ToString("yyyy-MM-ddTHH:mm:ssZ")">
        <meta itemprop="description" content="@Model.BookOrArticle.BookDescription">

    </span>

    @* Выбор картинки для книги  display:none *@
    <span class="d-none" itemprop="image" itemscope itemtype="http://schema.org/ImageObject">

        @if (Model.BookOrArticle.LogoOfArticle != null)
        {
            <meta itemprop="caption" content="@Model.BookOrArticle.LogoOfArticle.ImageCaption">
            <link itemprop="contentUrl url" href="https://@Context.Request.Host@Model.BookOrArticle.LogoOfArticle.ImagePath/@Model.BookOrArticle.LogoOfArticle.WebImageFileName">
            <link itemprop="thumbnailUrl" href="https://@Context.Request.Host@Model.BookOrArticle.LogoOfArticle.ImagePath/@Model.BookOrArticle.LogoOfArticle.WebIconFileName">
            <meta itemprop="width" content="@Model.BookOrArticle.LogoOfArticle.WebImageWidth">
            <meta itemprop="height" content="@Model.BookOrArticle.LogoOfArticle.WebImageHeight">
        }
        else
        {
            <meta itemprop="caption" content="@Model.PageInfo.ImageFileModel!.ImageCaption">
            <link itemprop="contentUrl url" href="https://@Context.Request.Host@Model.PageInfo.ImageFileModel.ImagePath/@Model.PageInfo.ImageFileModel.WebImageFileName">
            <link itemprop="thumbnailUrl" href="https://@Context.Request.Host@Model.PageInfo.ImageFileModel.ImagePath/@Model.PageInfo.ImageFileModel.WebIconFileName">
            <meta itemprop="width" content="@Model.PageInfo.ImageFileModel.WebImageWidth">
            <meta itemprop="height" content="@Model.PageInfo.ImageFileModel.WebImageHeight">
        }

    </span>

    @* Страница *@
    <div class="row justify-content-center py-3 bg-secondary-subtle bg-opacity-25 shadw">

        @* Кадры слева *@
        <div id="picturesFromLeft" class="d-none d-md-flex flex-column col-md-2 overflow-y-auto overflow-x-hidden">

            @if (Model.FramesAroundMainContent?.FramesOnTheLeft != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheLeft)
                {
                    @* Вывод фотографии в отдельное окно *@
                    @* <a href="@item.ImagePath/@(string.IsNullOrEmpty(item.WebImageHDFileName) == false ? item.WebImageHDFileName : item.WebImageFileName)"
                       class=""
                       title="@item.ImageAltTitle"
                       onclick="this.target='_blank'"> *@

                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="shadw imageref"
                                       icon-type="webicon200" />
                    </a>
                }
            }

        </div>

        @* Заголовок книги и текст страницы*@
        <div id="blockForAllOptions" class="col-12 col-md-8 pb-3">

            @* Заголовок книги *@
            <header itemprop="headline" class="my-3 mx-auto">

                <h1 class="lay1 p-2 lh-1 times-new-roman">

                    <span class="fs-2 fw-bold d-inline-block h1_print">
                        @Model.BookOrArticle.AuthorOfText
                    </span>
                    <span class="d-block mt-2 fs-2 fw-bold">
                        «@Model.BookOrArticle.CaptionOfText»
                    </span>
                    <span class="@(Model.PageNumber == 0 ? "d-block fs-5 mt-3 text_shadow" : "d-none")">
                        @Model.BookOrArticle.TheSubtitle
                    </span>

                </h1>

            </header>

            @* Текст страницы *@
            <div class="article_page mx-auto paragraph shadw
                @(Model.PageNumber == 0 ? "px-0 px-sm-2 px-md-3" : "")"
                 itemprop="articleBody text">

                @* Инфо вверху страницы *@
                <div class="@(Model.Scan == true ? "d-none" : "d-flex mb-4 top_page align-items-center d-print-none")">

                    @* Иконка аудио *@
                    <a class="@((Model.AudioFileForText != null && Model.AudioFileForText.AudioBookModel != null) ? "col-width-content me-2" : "d-none")"
                       asp-area=""
                       asp-controller="Books"
                       asp-action="AudioBook"
                       asp-route-audioBookCaption="@Model.AudioFileForText?.AudioBookModel?.CaptionOfAudioBook"
                       asp-route-audioBookPart="@Model.AudioFileForText?.SequenceNumber"
                       asp-route-audioActor="@Model.AudioFileForText?.AudioBookModel?.ActorOfAudioBook"
                       title="аудиокнига">

                        <vc:view-image image-id="@DataConfig.AudioImage"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Иконка видео *@
                    @* <a class="@(Model.BookOrArticle.VideoForBookOrArticle == null ? "d-none" : "col-width-content mx-2")"
                       asp-area=""
                       asp-controller="AllVideo"
                       asp-action="Movie"
                       asp-route-movieId="@Model.BookOrArticle.VideoForBookOrArticleId"
                       asp-route-pageOfSeries="true"
                       asp-route-videohosting="@Model.BookOrArticle.VideoForBookOrArticle?.MovieVkVideo"
                       title="видео к тексту">

                        <vc:view-image image-id="b386f45b-fc84-4748-bc75-08dd67cfc8ed"
                                       css-class="maxwidth40px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a> *@

                    @* Иконка фильма *@
                    <a class="@(Model.BookOrArticle.FilmForBookOrArticle == null ? "d-none" : "col-width-content me-2")"
                       asp-area=""
                       asp-controller="Films"
                       asp-action="Film"
                       asp-route-filmCaption="@Model.BookOrArticle.FilmForBookOrArticle?.FilmCaption"
                       asp-route-host="@Model.BookOrArticle.FilmForBookOrArticle?.FilmContentUrl"
                       title="видео к тексту">

                        <vc:view-image image-id="b386f45b-fc84-4748-bc75-08dd67cfc8ed"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Иконка принтера *@
                    <a class="col-width-content"
                       href="javascript:window.print(); void 0;"
                       title="распечатать страницу">

                        <vc:view-image image-id="@DataConfig.PrintImage"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Номер страницы *@
                    <p class="col-width-content ms-auto text-primary nomstr fluid-font-size @(Model.PageNumber == 0 ? "d-none" : "")">

                        @Model.PageNumber

                    </p>

                </div>

                @* Текст страницы *@
                <div class="minheight900 times-new-roman">

                    @Html.Raw(Model.HtmlText)

                </div>

                @* Инфо внизу страницы *@
                <footer class="@(Model.Scan == true ? "d-none" : "d-flex mt-4 top_page align-items-center d-print-none")">

                    @* Иконка аудио *@
                    <a class="@((Model.AudioFileForText != null && Model.AudioFileForText.AudioBookModel != null) ? "col-width-content me-2" : "d-none")"
                       asp-area=""
                       asp-controller="Books"
                       asp-action="AudioBook"
                       asp-route-audioBookCaption="@Model.AudioFileForText?.AudioBookModel?.CaptionOfAudioBook"
                       asp-route-audioBookPart="@Model.AudioFileForText?.SequenceNumber"
                       asp-route-audioActor="@Model.AudioFileForText?.AudioBookModel?.ActorOfAudioBook"
                       title="аудиокнига">

                        <vc:view-image image-id="@DataConfig.AudioImage"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Иконка видео *@
                    @* <a class="@(Model.BookOrArticle.VideoForBookOrArticle == null ? "d-none" : "col-width-content mx-2")"
                       asp-area=""
                       asp-controller="AllVideo"
                       asp-action="Movie"
                       asp-route-movieId="@Model.BookOrArticle.VideoForBookOrArticleId"
                       asp-route-pageOfSeries="true"
                       asp-route-videohosting="@Model.BookOrArticle.VideoForBookOrArticle?.MovieVkVideo"
                       title="видео к тексту">

                        <vc:view-image image-id="b386f45b-fc84-4748-bc75-08dd67cfc8ed"
                                       css-class="maxwidth40px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a> *@

                    @* Иконка фильма *@
                    <a class="@(Model.BookOrArticle.FilmForBookOrArticle == null ? "d-none" : "col-width-content me-2")"
                       asp-area=""
                       asp-controller="Films"
                       asp-action="Film"
                       asp-route-filmCaption="@Model.BookOrArticle.FilmForBookOrArticle?.FilmCaption"
                       asp-route-host="@Model.BookOrArticle.FilmForBookOrArticle?.FilmContentUrl"
                       title="видео к тексту">

                        <vc:view-image image-id="b386f45b-fc84-4748-bc75-08dd67cfc8ed"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Иконка принтера *@
                    <a class="col-width-content"
                       href="javascript:window.print(); void 0;"
                       title="распечатать страницу">

                        <vc:view-image image-id="@DataConfig.PrintImage"
                                       css-class="maxwidth30px shadw imageref d-print-none"
                                       icon-type="webicon100" />

                    </a>

                    @* Номер страницы *@
                    <p class="col-width-content ms-auto text-primary nomstr fluid-font-size @(Model.PageNumber == 0 ? "d-none" : "")">

                        @Model.PageNumber

                    </p>

                </footer>

            </div>

        </div>

        @* Кадры справа *@
        <div id="picturesFromRight" class="d-none d-md-flex flex-column col-md-2 overflow-y-auto overflow-x-hidden">

            @if (Model.FramesAroundMainContent != null && Model.FramesAroundMainContent.FramesOnTheRight != null)
            {
                @foreach (var item in Model.FramesAroundMainContent.FramesOnTheRight)
                {
                    @* Вывод фотографии в отдельное окно *@
                    @* <a href="@item.ImagePath/@(string.IsNullOrEmpty(item.WebImageHDFileName) == false ? item.WebImageHDFileName : item.WebImageFileName)"
                       class=""
                       title="@item.ImageAltTitle"
                       onclick="this.target='_blank'"> *@

                    <a asp-area=""
                       asp-controller="Books"
                       asp-action="PhotoAlbum"
                       asp-route-imageId="@item.ImageFileModelId"
                       asp-route-albumCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
                       class="d-block w-100 mb-2">

                        <vc:view-image image-id="@item.ImageFileModelId"
                                       css-class="shadw imageref"
                                       icon-type="webicon200" />
                    </a>
                }
            }

        </div>

    </div>

    @* Навигация по статье *@
    <div class="@(Model.PageNumber == 0 ? "d-none" : "col col-md-8 maxwidth700px mt-4 mb-0 mx-auto clearfix d-print-none")">

        @* переход к предыдущей странице*@
        <a class="@((Model.PageNumber > 1) ? "btn btn-outline-primary py-0 float-start shadw" : "d-none")"
           asp-area=""
           asp-controller="Books"
           asp-action="Book"
           asp-route-bookCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
           asp-route-pageNumber="@(Model.PageNumber - 1)"
           title="предыдущая страница"
           itemprop="url">

            &lt;&lt;
            <span class="nomstr fluid-font-size">
                @(Model.PageNumber - 1)
            </span>

        </a>

        @* переход к следующей странице*@
        <a class="@((Model.PageNumber < Model.BookOrArticle.NumberOfPages) ? "btn btn-outline-primary py-0 float-end shadw" : "d-none")"
           asp-area=""
           asp-controller="Books"
           asp-action="Book"
           asp-route-bookCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
           asp-route-pageNumber="@(Model.PageNumber + 1)"
           title="следующая страница"
           itemprop="url">

            <span class="nomstr fluid-font-size">
                @(Model.PageNumber + 1) &gt;&gt;
            </span>

        </a>

    </div>

    @* Раскрывающиеся поля *@
    <div class="@(Model.PageNumber == 0 ? "d-none" : "") bg-dark-subtle bg-opacity-10 p-3 mt-4 shadw">

        <div id="accordionForBook" class="@(Model.PageNumber == 0 ? "d-none" : "accordion maxwidth700px mx-auto mt-4 d-print-none")">

            @* Страницы книги *@
            <div id="bookPagesAccordionItem" class="accordion-item my-3 shadw">

                @* заголовок группы «страницы книги» *@
                <h2 id="headingPagesOfBook" class="accordion-header shadw">

                    <button class="accordion-button collapsed py-2 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#PagesOfBook"
                            aria-expanded="true"
                            aria-controls="PagesOfBook">

                        <span class="d-flex pb-1">
                            Страницы книги :
                        </span>

                    </button>

                </h2>

                <div id="PagesOfBook"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingPagesOfBook"
                     data-bs-parent="#accordionForBook">

                    <div id="bookPagesAccordionItem" class="accordion-body text-indent-0 text-center px-1">

                        @for (int i = 0; i < Model.BookOrArticle.NumberOfPages; i++)
                        {
                            <a asp-area=""
                               asp-controller="Books"
                               asp-action="Book"
                               asp-route-bookCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
                               asp-route-pagenumber="@(i + 1)"
                               class="ref-to-page rounded ten @(Model.PageNumber == (i + 1) ? "border border-primary border-2" : "border border-1 border-secondary")"
                               title="страница @(i + 1)"
                               itemprop="url">

                                @(i + 1)

                            </a>
                        }
                    </div>

                </div>

            </div>

            @* Скачать книгу *@
            <div id="downloadBookAccordionItem" class="accordion-item my-3 shadw">

                @* Заголовок группы «скачать книгу» *@
                <h2 id="headingLoadBook" class="accordion-header shadw">

                    <button class="accordion-button collapsed py-2 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#LoadBook"
                            aria-expanded="true"
                            aria-controls="LoadBook">

                        @* Картинки на кнопке аккордеона *@
                        <div class="container ps-0">

                            <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                <span class="d-none d-sm-block me-2 text-start">
                                    Скачать книгу :
                                </span>

                                @* Word *@
                                <vc:view-image image-id="@DataConfig.WordImage"
                                               css-class="border border-secondary rounded maxwidth60px"
                                               icon-type="webicon100" />

                                @* Pdf *@
                                <vc:view-image image-id="@DataConfig.PdfImage"
                                               css-class="border border-secondary rounded maxwidth60px"
                                               icon-type="webicon100" />

                                @* Audio *@
                                <vc:view-image image-id="@DataConfig.AudioImage"
                                               css-class="border border-secondary rounded maxwidth60px @(Model.BookOrArticle.RefToAudio == null ? "d-none" : "")"
                                               icon-type="webicon100" />

                            </div>

                        </div>

                    </button>

                </h2>

                <div id="LoadBook"
                     class="accordion-collapse collapse p-2"
                     aria-labelledby="headingLoadBook"
                     data-bs-parent="#accordionForBook">

                    <div id="downloadBookAccordionBody" class="accordion-body accordion-body-nointend">

                        <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                            @* Текст в формате word *@
                            <a class="@(Model.BookOrArticle.RefToWordDoc == null ? "d-none" : "")"
                               href="@Model.BookOrArticle.RefToWordDoc"
                               title="скачать в формате word"
                               onClick="this.target='_blank'">

                                <vc:view-image image-id="@DataConfig.WordImage"
                                               css-class="shadw imageref"
                                               icon-type="webicon300" />

                            </a>

                            @* Текст в формате pdf *@
                            <a class="@(Model.BookOrArticle.RefToPdf == null ? "d-none" : "")"
                               href="@Model.BookOrArticle.RefToPdf"
                               title="скачать в формате pdf"
                               onClick="this.target='_blank'">

                                <vc:view-image image-id="@DataConfig.PdfImage"
                                               css-class="shadw imageref"
                                               icon-type="webicon300" />

                            </a>

                            @* аудиокнига *@
                            <a class="@(Model.BookOrArticle.RefToAudio == null ? "d-none" : "")"
                               href="@Model.BookOrArticle.RefToAudio"
                               title="скачать аудиокнигу"
                               onClick="this.target='_blank'">

                                <vc:view-image image-id="@DataConfig.AudioImage"
                                               css-class="shadw imageref"
                                               icon-type="webicon300" />

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            @* Фото из книги *@
            <div class="@((Model.ListOfPictures != null && Model.ListOfPictures.Count > 0) ? "accordion-item my-3 shadw" : "d-none")">

                @* Заголовок группы «фото из книги» *@
                <h2 id="headingPhoto" class="accordion-header shadw">

                    <button class="accordion-button collapsed py-2 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#Photo"
                            aria-expanded="true"
                            aria-controls="Photo">

                        @* Картинки на кнопке аккордеона *@
                        <div class="container ps-0">

                            <div class="d-flex flex-wrap align-items-center justify-content-start gap-2">

                                <span class="d-none d-sm-block me-2">
                                    Фото из книги :
                                </span>

                                @if (Model.ListOfPictures != null && Model.ListOfPictures.Count > 0)
                                {
                                    @do
                                    {
                                        Random rnd = new();

                                        int rndIndex = rnd.Next(Model.ListOfPictures.Count);

                                        <vc:view-image image-id="@Model.ListOfPictures[rndIndex].ImageFileModelId"
                                                       css-class="border border-secondary rounded maxwidth60px"
                                                       icon-type="webicon100" />
                                        n++;
                                    }
                                    while (n < Model.ListOfPictures.Count && n < 4);
                                }

                            </div>

                        </div>

                    </button>

                </h2>

                <div id="Photo" class="accordion-collapse collapse" aria-labelledby="headingPhoto" data-bs-parent="#accordionForBook">

                    <div class="accordion-body accordion-body-nointend p-0 pt-2">

                        @* <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2 pb-2 justify-content-center"> - для «webicon200» *@
                        <div class="row row-cols-2 row-cols-sm-4 row-cols-md-5 row-cols-lg-6 g-4 pb-2 justify-content-center">

                            @if (Model.ListOfPictures != null)
                            {

                                @foreach (var item in Model.ListOfPictures)
                                {
                                    <a asp-area=""
                                       asp-controller="Books"
                                       asp-action="PhotoAlbum"
                                       asp-route-albumCaption="@Model.BookOrArticle.CaptionOfText.Replace(' ', '-')"
                                       asp-route-imageId="@item.ImageFileModelId"
                                       class="col w-auto rounded-3 text-center">

                                        <vc:view-image image-id="@item.ImageFileModelId.ToString()"
                                                       css-class="rounded-3 shadw imageref"
                                                       icon-type="webicon100" />
                                    </a>
                                }
                            }

                        </div>

                    </div>

                </div>

            </div>

            @* Аудио *@
            <div class="@((Model.TextForBookOrArticle != null && Model.TextForBookOrArticle.AudioInfoModel != null
                                                                                                                                        && !string.IsNullOrEmpty(Model.TextForBookOrArticle.AudioInfoModel.PlayerPodsterFm)) ? "accordion-item my-3 shadw" : "d-none")">
                @* Заголовок группы «Аудио» *@
                <h2 id="headingAudioForPage" class="accordion-header shadw">

                    <button class="accordion-button collapsed py-2 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#AudioForPage"
                            aria-expanded="true"
                            aria-controls="AudioForPage">

                        <span class="d-inline-block w-100 fs-5">
                            Аудиокнига :
                        </span>

                    </button>

                </h2>

                <div id="AudioForPage"
                     class="accordion-collapse collapse p-2 py-3"
                     aria-labelledby="headingAudioForPage"
                     data-bs-parent="#accordionForBook">

                    <div class="accordion-body accordion-body-nointend">

                        <p class="d-sm-none my-2 text_shadow ">
                            плеер отображается при разрешении экрана от 576px
                        </p>

                        <div class="d-none d-sm-flex my-2 shadw rounded-3 bg-dark">

                            @Html.Raw(Model.TextForBookOrArticle?.AudioInfoModel?.PlayerPodsterFm)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/sync-heights.js" asp-append-version="true"></script>
}