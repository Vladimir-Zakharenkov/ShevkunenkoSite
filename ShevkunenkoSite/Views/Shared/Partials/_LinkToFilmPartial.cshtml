@model FilmFileModel

@{
    bool isAdmin = Context.Request.IsAdminRequest();

    string href = (isAdmin
        ? Url.Action("DetailsFilm", "Films", new { area = "Admin", filmId = Model.FilmFileModelId })
        : Url.Action("Film", "Films", new { area = "", filmCaption = Model.FilmCaption }))
        ?? "#";
}

<a href="@href"
   target="@(isAdmin ? "_blank" : "_self")"
   rel="@(isAdmin ? null : "noopener noreferrer")"
   class="d-inline-flex mt-0"
   title="@(isAdmin ? "информация о фильме" : Model.FilmCaption.Replace("--", " "))">

    <partial name="_FilmSchemaOrgPartial" model="@Model" />

    <div id="imageCard" class="card">

        <vc:view-image image-id="@Model.FilmPosterId"
                       css-class="card-img-top imageref"
                       icon-type="webicon300" />

    </div>
</a>