@* data-ap-blacklist - атрибут блока запрещающий подстановку рекламы *@

@model PictureCarouselForFilmViewModel

@{
    async Task RenderCarousel(string carouselId, int interval, IEnumerable<ImageFileModel> pictures)
    {
        bool isFirst = true;

        <div id="@carouselId"
             class="carousel slide carousel-fade rounded-3 block-shadow"
             data-bs-ride="carousel"
             data-bs-interval="@interval">

            <div class="carousel-inner">

                @foreach (var picture in pictures)
                {
                    <div class="carousel-item @(isFirst ? "active" : "") p-0 rounded-3 block-shadow borderforitem">

                        <a asp-area=""
                           asp-controller="Films"
                           asp-action="FilmPhotoAlbum"
                           asp-route-imageId="@picture.ImageFileModelId"
                           asp-route-filmCaption="@Model.FilmCaption"
                           title="@picture.ImageAltTitle"
                           class="d-block">

                            <vc:view-image image-id="@picture.ImageFileModelId"
                                           css-class="d-block"
                                           icon-type="webimageAI" />

                        </a>

                    </div>

                    isFirst = false;
                }

            </div>

        </div>
    }
}

<div class="row justify-content-center">

    <div class="col">
        @{
            await RenderCarousel("multipleItemCarousel1", 3000, Model.FirstCarousel ?? Enumerable.Empty<ImageFileModel>());
        }
    </div>

    <div class="col">
        @{
            await RenderCarousel("multipleItemCarousel2", 5000, Model.SecondCarousel ?? Enumerable.Empty<ImageFileModel>());
        }
    </div>

    <div class="col">
        @{
            await RenderCarousel("multipleItemCarousel3", 4000, Model.ThirdCarousel ?? Enumerable.Empty<ImageFileModel>());
        }
    </div>

</div>