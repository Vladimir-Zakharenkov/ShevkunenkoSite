@using ShevkunenkoSite.Views.Shared.Components.Code

@model ViewImageViewModel

@{
    string sitePath = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var data = Model.GetImageData();
    var contentUrl = Model.GetContentUrl();
    var thumbnailUrl = Model.GetThumbnailUrl();
}

<div class="d-flex justify-content-center align-items-center rounded"
      itemscope itemtype="http://schema.org/ImageObject">

    <meta itemprop="name" content="@Model.ImageItem.ImageCaption" />
    <meta itemprop="caption" content="@Model.ImageItem.ImageCaption" />
    <meta itemprop="description" content="@Model.ImageItem.ImageDescription" />

    @if (contentUrl is not null)
    {
        <link itemprop="contentUrl" href="@sitePath@contentUrl" />
        <link itemprop="thumbnailUrl" href="@sitePath@thumbnailUrl" />
        <meta itemprop="width" content="@data.Width" />
        <meta itemprop="height" content="@data.Height" />

        <img class="text-indent-0 rounded-3 block-shadow @Model.CssClass"
             src="@contentUrl"
             asp-append-version="true"
             alt="@Model.ImageItem.ImageAltTitle"
             title="@Model.ImageItem.ImageAltTitle"
             itemprop="image"
             loading="lazy"
             decoding="async" />
    }
    else
    {
        <partial name="_NoImagePartial" model="@Model.CssClass" />
    }

</div>