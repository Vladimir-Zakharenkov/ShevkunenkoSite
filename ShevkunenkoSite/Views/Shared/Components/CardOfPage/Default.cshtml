@model PageInfoModel

<div class="col maxwidth300px rounded-3 cardborder">

    <div class="card shadw rounded-3" title="@Model.PageTitle">

        @if (Model.OgType == "movie" && Model.MovieFile != null)
        {
            <partial name="_MovieSchemaOrgPartial" model="Model.MovieFile" />
        }

        @if (Model.OgType == "article" && Model.TextInfo != null && Model.TextInfo.BooksAndArticlesModel != null)
        {
            <partial name="_ArticleSchemaOrgPartial" model="Model.TextInfo.BooksAndArticlesModel" />
        }

        @if (Model.OgType == "book" && Model.TextInfo != null && Model.TextInfo.BooksAndArticlesModel != null)
        {
            <partial name="_BookSchemaOrgPartial" model="Model.TextInfo.BooksAndArticlesModel" />
        }

        @if (Model.OgType == "audiobook" && Model.AudioInfo != null)
        {
            <partial name="_AudioSchemaOrgPartial" model="Model.AudioInfo" />
        }

        @if (Model.OgType == "book" && Model.TextInfo != null && Model.TextInfo.BooksAndArticlesModel != null)
        {
            <a asp-area=""
               asp-controller="Books"
               asp-action="Book"
               asp-route-bookCaption="@Model.TextInfo.BooksAndArticlesModel.CaptionOfText.Replace(' ', '-')"
               asp-route-pageNumber=0
               class="rounded-3">

                @if (Model.ImageFileModel != null)
                {
                    <vc:view-image image-id="@Model.ImageFileModel.ImageFileModelId"
                                   css-class="card-img-top shadw rounded-3"
                                   icon-type="webicon300" />
                }
                else
                {
                    <vc:view-image image-id="@DataConfig.NoImage"
                                   css-class="card-img-top shadw rounded-3"
                                   icon-type="webicon300" />
                }

                @if (!string.IsNullOrEmpty(Model.PageCardText))
                {
                    <div class="d-none d-sm-block card-body rounded-2 p-0 mt-1 mt-md-2 shadw cardBodyBg">

                        <p class="card-title p-0 mb-0 fw-medium fontadaptive">

                            @Model.PageCardText

                        </p>

                    </div>
                }

            </a>
        }
        else
        {
            <a class="rounded-3 p-0"
               href="@Url.Content((Model.PagePathNickName != string.Empty ? Model.PagePathNickName : Model.PageFullPathWithData))"
               title="@Model.PageTitle"
               itemprop="url">

                @if (Model.ImageFileModel != null)
                {
                    <vc:view-image image-id="@Model.ImageFileModel.ImageFileModelId"
                                   css-class="card-img-top shadw rounded-3"
                                   icon-type="webicon300" />
                }
                else
                {
                    <vc:view-image image-id="@DataConfig.NoImage"
                                   css-class="card-img-top shadw rounded-3"
                                   icon-type="webicon300" />
                }

                @if (!string.IsNullOrEmpty(Model.PageCardText))
                {
                    <div class="d-none d-sm-block card-body rounded-2 p-0 mt-1 mb-1 shadw cardBodyBg">

                        <p class="card-title p-0 py-1 mb-0 fw-medium fontadaptive">

                            @Model.PageCardText

                        </p>

                    </div>
                }

            </a>
        }

    </div>

</div>