@model MoviesListViewModel

<div id="refMovies" class="">

    <div id="filmCaption" class="row bg-secondary-subtle shadw">

        <h2 id="movieCaptionTegH2" class="col text_shadow">

            @Html.Raw(Model.PageHeadTitle)

        </h2>

    </div>

    <div class="row row-cols-3 row-cols-lg-4 row-cols-xxl-5 py-3 mt-2 mb-4 bg-primary-subtle justify-content-center shadw">

        @foreach (var movieFile in Model?.Movies ?? Enumerable.Empty<MovieFileModel>())
        {
            <vc:video-card movie-file-model="@movieFile"
                           is-parts-more-one="@Model!.IsPartsMoreOne"
                           is-image="@Model.IsImage"
                           icon-type="@Model.IconType"
                           link-to-info-about-movie=@Model.LinkToInfoAboutMovie />
        }

    </div>

</div>