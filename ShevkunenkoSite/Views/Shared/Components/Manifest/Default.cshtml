<script>

    let url = '/api/manifest';
    // let response = await fetch(url);

    // let commits = await response.text(); // читаем ответ в формате JSON

    // alert(commits);

    const manifest = {
      name: 'My App',
      short_name: 'My App',
      display: 'standalone',
      theme_color: '#ffffff',
      background_color: '#ffffff',
      icons: [
        { src: `${window.location.origin}/icon-192x192.png`, sizes: '192x192', type: 'image/png' },
      ],
      start_url: window.location.href
    };

    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = `data:application/json;base64,${btoa(JSON.stringify(manifest))}`;
    //link.href = `data:application/json;base64,${btoa(JSON.stringify(commits))}`;
    document.head.appendChild(link);

</script>