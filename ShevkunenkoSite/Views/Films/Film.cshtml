@model FilmFileModel

@{
    string screenFormat = ((int)(((double)Model.FilmHeight / (double)Model.FilmWidth) * 100)).ToString() + "%";

    string posterForVideo = string.Empty;
}

@* Заголовок страницы *@
<div class="row-col-1">

    <h1 class="h2 text_shadow">@Model.FilmCaption.Replace("--", " ")</h1>

    <hr class="liniya" />

</div>

@* Основной блок ВИДЕО *@
<div class="row">

    @* кадры слева *@
    <div class="d-none d-md-block col-md-2 mx-auto overflow-y-auto overflow-x-hidden foto-around">

        @foreach (var item in Model.FramesOnTheLeft)
        {
            <a asp-area=""
               asp-controller="Films"
               asp-action="FilmPhotoAlbum"
               asp-route-imageId="@item.ImageFileModelId"
               asp-route-filmCaption="@Model.FilmCaption"
               title="@item.ImageAltTitle"
               class="">

                <vc:view-image image-id="@item.ImageFileModelId"
                               css-class="my-2 w-100 shadw imageref"
                               icon-type="webicon200" />

            </a>
        }

    </div>

    @* Видео *@
    <div class="col-12 col-md-8 mb-3">

        <div class="row">

            <div class="col-12 p-0 p-sm-1 p-xl-2 mb-3 shadw">

                @* Данные http://schema.org/VideoObject  *@
                <span itemprop="video" itemscope itemtype="http://schema.org/VideoObject">

                    <meta itemprop="name" content="@Model.FilmCaption" />
                    <meta itemprop="caption" content="@Model.FilmCaption" />
                    <link itemprop="url" href="@Model.FilmContentUrl" />
                    <link itemprop="contentUrl" href="@Model.FilmContentUrl" />
                    <meta itemprop="description" content="@Model.FilmDescriptionForSchemaOrg" />
                    <meta itemprop="duration" content="@Model.FilmDuration.ToString("'T'hh'H'mm'M'ss'S'")" />
                    <meta itemprop="isFamilyFriendly" content="@Model.FilmIsFamilyFriendly.ToString()" />
                    <link itemprop="thumbnail" href="https://@Context.Request.Host@Model.FilmImage.ImagePath/@Model.FilmImage.ImageFileName" />
                    <link itemprop="thumbnailUrl" href="https://@Context.Request.Host@Model.FilmImage.ImagePath/@Model.FilmImage.ImageFileName" />
                    <meta itemprop="uploadDate" content="@Model.FilmUploadDate.ToString("yyyy-MM-dd")" />
                    <meta itemprop="height" content="@Model.FilmHeight" />
                    <meta itemprop="width" content="@Model.FilmWidth" />

                    @if (Model.FilmHeight <= 360)
                    {
                        <meta itemprop="videoQuality" content="low" />
                    }

                    @if (Model.FilmHeight > 360 & Model.FilmHeight <= 720)
                    {
                        <meta itemprop="videoQuality" content="medium" />
                    }

                    @if (Model.FilmHeight > 720 & Model.FilmHeight < 1080)
                    {
                        <meta itemprop="videoQuality" content="HD" />
                    }

                    @if (Model.FilmHeight >= 1080)
                    {
                        <meta itemprop="videoQuality" content="full HD" />
                    }
                    <meta itemprop="contentSize" content="@Model.FilmFileSize.ToString().Substring(0, Model.FilmFileSize.ToString().Length - 3)" />
                    <meta itemprop="dateReleased" content="@Model.FilmDatePublished.ToString("yyyy-MM-dd")" />
                    <meta itemprop="dateCreated" content="@Model.FilmDateCreated.ToString("yyyy-MM-dd")" />
                    <meta itemprop="inLanguage" content="@Model.FilmInLanguage1" />
                    @if (!string.IsNullOrEmpty(Model.FilmInLanguage2))
                    {
                        <meta itemprop="inLanguage" content="@Model.FilmInLanguage2" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmSubtitles1))
                    {
                        <meta itemprop="subtitleLanguage" content="@Model.FilmSubtitles1" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmSubtitles2))
                    {
                        <meta itemprop="subtitleLanguage" content="@Model.FilmSubtitles2" />
                    }
                    <meta itemprop="part" content="@Model.FilmPart" />
                    <meta itemprop="genre" content="@Model.FilmGenre" />
                    <meta itemprop="content_id" content="@Model.FilmFileModelId" />
                    <meta itemprop="productionCompany" content="@Model.FilmРroductionCompany" />
                    @if (!string.IsNullOrEmpty(Model.FilmDirector1))
                    {
                        <meta itemprop="director" content="@Model.FilmDirector1" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmDirector2))
                    {
                        <meta itemprop="director" content="@Model.FilmDirector2" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmMusicBy))
                    {
                        <meta itemprop="musicBy" content="@Model.FilmMusicBy" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor01))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor01" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor02))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor02" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor03))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor03" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor04))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor04" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor05))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor05" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor06))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor06" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor07))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor07" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor08))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor08" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor09))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor09" />
                    }

                    @if (!string.IsNullOrEmpty(Model.FilmActor10))
                    {
                        <meta itemprop="actor" content="@Model.FilmActor10" />
                    }

                    <meta itemprop="image" content="https://@Context.Request.Host@Model.FilmImage.ImagePath/@Model.FilmImage.ImageFileName" />
                    <meta itemprop="playerType" content="@Model.FilmMimeType" />
                    <meta itemprop="availablePlatform" content="Desktop" />
                    <meta itemprop="availablePlatform" content="Mobile" />

                </span>

                @* Воспроизведение видео *@
                <div class="div-adaptiv mx-auto" style="padding-bottom:@screenFormat">

                    @* Video -JS *@
                    @if (Model.CurrentVideoHost == Model.FilmContentUrl)
                    {
                        <video id="my-video"
                               class="video-js video-adaptiv px-1"
                               controls
                               preload="auto"
                               width="@Model.FilmWidth"
                               height="@Model.FilmHeight"
                               poster="@posterForVideo"
                               data-setup="{}">

                            <source src="@Model.CurrentVideoHost" type="@Model.FilmMimeType" />

                            <p class="vjs-no-js">
                                To view this video please enable JavaScript, and consider upgrading to a web browser that
                                <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
                            </p>

                        </video>

                        <script src="https://vjs.zencdn.net/8.23.7/video.min.js"></script>

                        <script>
                            var player = videojs('playerId', {
                            html5: {
                            vhs: {
                            overrideNative: true
                            },
                            nativeAudioTracks: false,
                            nativeVideoTracks: false
                            }
                            });
                        </script>
                    }
                    else
                    {
                        <iframe class="video-adaptiv" src="@Model.CurrentVideoHost" allowfullscreen></iframe>
                    }

                </div>

                @* Списки под видео *@
                <div id="movieDescription" class="accordion mt-4 mb-2 p-1">

                    @* Описание фильма *@
                    <div class="accordion-item shadw">

                        <h2 id="heading1" class="accordion-header">

                            <button class="accordion-button collapsed p-1"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse1"
                                    aria-expanded="true"
                                    aria-controls="collapse1">

                                <div>

                                    Содержание:
                                    <span id="descr">
                                        @Model.FilmDescriptionForSchemaOrg.StartOfDescription()
                                    </span>

                                </div>

                            </button>

                        </h2>

                        <div id="collapse1"
                             class="accordion-collapse collapse"
                             aria-labelledby="heading1"
                             data-bs-parent="#movieDescription">

                            <div class="accordion-body">

                                @Html.Raw(Model.FilmDescriptionHtml)

                            </div>

                        </div>

                    </div>

                    @* Выбрать видеохостинг *@
                    <div class="accordion-item shadw mt-3">

                        @* Заголовок вкладки*@
                        <h2 id="heading2" class="accordion-header">

                            <button class="accordion-button collapsed p-1"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse2"
                                    aria-expanded="true"
                                    aria-controls="collapse2">

                                <span class="d-none d-sm-block pe-1">
                                    Видео на :
                                </span>

                                @* YouTube *@
                                <vc:view-image image-id="@DataConfig.YoutubeImage"
                                               css-class="maxwidth40px me-1 @(Context.Request.QueryString.ToString().Contains("yt", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* VkVideo *@
                                <vc:view-image image-id="@DataConfig.VkVideoImage"
                                               css-class="maxwidth40px me-1 @(Context.Request.QueryString.ToString().Contains("vk", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* MailRuVideo *@
                                <vc:view-image image-id="@DataConfig.MailRuVideoImage"
                                               css-class="maxwidth40px me-1 @(Context.Request.QueryString.ToString().Contains("ml", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* OkVideo *@
                                <vc:view-image image-id="@DataConfig.OkVideoImage"
                                               css-class="maxwidth40px me-1 @(Context.Request.QueryString.ToString().Contains("ok", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* AsusVideo *@
                                <vc:view-image image-id="@DataConfig.AsusVideoImage"
                                               css-class="maxwidth40px me-1 @(Context.Request.QueryString.ToString().Contains("ss", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* YandexDisk *@
                                <vc:view-image image-id="@DataConfig.YandexDiskImage"
                                               css-class="maxwidth40px"
                                               icon-type="webicon100" />

                            </button>

                        </h2>

                        <div id="collapse2"
                             class="accordion-collapse collapse"
                             aria-labelledby="heading2"
                             data-bs-parent="#movieDescription">

                            <div class="accordion-body accordion-body-nointend">

                                <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                    @* YouTube *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="yt">

                                        <vc:view-image image-id="@DataConfig.YoutubeImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("yt", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* vk.com *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="vk">

                                        <vc:view-image image-id="@DataConfig.VkVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("vk", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @*mail.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ml">

                                        <vc:view-image image-id="@DataConfig.MailRuVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ml", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* ok.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ok">

                                        <vc:view-image image-id="@DataConfig.OkVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ok", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* sergeyshef.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ss">

                                        <vc:view-image image-id="@DataConfig.AsusVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ss", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* Yandex Disk *@
                                    <a onClick="this.target='_blank'" href="@Model.FilmYandexDiskVideo">

                                        <vc:view-image image-id="@DataConfig.YandexDiskImage"
                                                       css-class="col shadw imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Информация о фильме *@
                    @if (Model.FilmKinoTeatrRu != null || Model.FilmKinoPoisk != null || Model.FilmImbd != null)
                    {
                        <div class="accordion-item shadw mt-3">

                            <h2 id="heading3" class="accordion-header">

                                <button class="accordion-button collapsed p-1"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse3"
                                        aria-expanded="true"
                                        aria-controls="collapse3">

                                    <span class="d-none d-sm-block pe-1">
                                        О фильме :
                                    </span>

                                    @* Kino-Teatr.Ru *@
                                    <vc:view-image image-id="@DataConfig.KinoTeatrImage"
                                                   css-class="maxwidth40px me-1"
                                                   icon-type="webicon100" />

                                    @* Kinopoisk.Ru *@
                                    <vc:view-image image-id="@DataConfig.KinopoiskImage"
                                                   css-class="maxwidth40px me-1"
                                                   icon-type="webicon100" />

                                    @* IMDB.com *@
                                    <vc:view-image image-id="@DataConfig.ImdbImage"
                                                   css-class="maxwidth40px"
                                                   icon-type="webicon100" />

                                </button>

                            </h2>

                            <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="heading3" data-bs-parent="#movieDescription">

                                <div class="accordion-body accordion-body-nointend">

                                    <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                        @* Kino-Teatr.Ru *@
                                        <a onClick="this.target='_blank'" href="@Model.FilmKinoTeatrRu">

                                            <vc:view-image image-id="@DataConfig.KinoTeatrImage"
                                                           css-class="col-12 shadw imageref"
                                                           icon-type="webicon300" />

                                        </a>

                                        @* Kinopoisk.Ru *@
                                        <a onClick="this.target='_blank'" href="@Model.FilmKinoPoisk">

                                            <vc:view-image image-id="@DataConfig.KinopoiskImage"
                                                           css-class="col-12 shadw imageref"
                                                           icon-type="webicon300" />

                                        </a>

                                        @* IMDB.com *@
                                        <a onClick="this.target='_blank'" href="@Model.FilmImbd">

                                            <vc:view-image image-id="@DataConfig.ImdbImage"
                                                           css-class="col-12 shadw imageref"
                                                           icon-type="webicon300" />

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    @* кадры справа *@
    <div class="d-none d-md-block col-md-2 mx-auto overflow-y-auto overflow-x-hidden foto-around">

        @foreach (var item in Model.FramesOnTheRight)
        {
            @* Вывод фотографии в отдельное окно *@
            @* <a href="@item.ImagePath/@(string.IsNullOrEmpty(item.WebImageHDFileName) == false ? item.WebImageHDFileName : item.WebImageFileName)"
                   class=""
                   title="@item.ImageAltTitle"
                   onclick="this.target='_blank'"> *@

            <a asp-area=""
               asp-controller="Films"
               asp-action="FilmPhotoAlbum"
               asp-route-imageId="@item.ImageFileModelId"
               asp-route-filmCaption="@Model.FilmCaption"
               title="@item.ImageAltTitle"
               class="">

                <vc:view-image image-id="@item.ImageFileModelId"
                               css-class="my-2 w-100 shadw imageref"
                               icon-type="webicon200" />

            </a>
        }

    </div>

</div>