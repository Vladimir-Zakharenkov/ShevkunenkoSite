@* data-ap-blacklist  - атрибут блока запрещающий подстановку рекламы *@

@model FilmFileModel

@{
    // Адаптивный экран Video-JS
    string screenFormat = ((int)(((double)Model.FilmHeight / (double)Model.FilmWidth) * 100)).ToString() + "%";

    string posterForVideo = string.Empty;

    // количество миниатюр кадров фильма
    int n = 0;
}

@* Заголовок страницы *@
<div id="filmCaption" class="row mb-3 bg-secondary-subtle shadw">

    <h1 id="filmCaptionTegH1" class="col h2 text_shadow">

        @Model.FilmCaption.Replace("--", " ")

    </h1>

</div>

@* Общий блок *@
<div id="filmView" class="row bg-secondary-subtle py-2 shadw">

    @* кадры слева *@
    <div id="leftPictures" class="d-none d-md-block col-md-2 overflow-y-auto overflow-x-hidden foto-around">

        @foreach (var item in Model.FramesOnTheLeft)
        {
            <a asp-area=""
               asp-controller="Films"
               asp-action="FilmPhotoAlbum"
               asp-route-imageId="@item.ImageFileModelId"
               asp-route-filmCaption="@(Model.FilmForPictureAround == null ? Model.FilmCaption : Model.FilmForPictureAround.FilmCaption)"
               class=""
               title="@item.ImageAltTitle">

                <vc:view-image image-id="@item.ImageFileModelId"
                               css-class="my-2 w-100 shadw imageref"
                               icon-type="webicon200" />

            </a>
        }

    </div>

    @* видео *@
    <div id="videoBlock" class="col-12 col-md-8 mb-3 shadw no-ads-zone">

        <div id="videoBlockRow" class="row">

            <div id="videoBlockCols" class="col-12 p-0 p-sm-1 p-xl-2 shadw">

                @* Данные http://schema.org/VideoObject  *@
                <partial name="_FilmSchemaOrgPartial" model="@Model" />

                @* Воспроизведение видео *@
                <div id="videoScreen" class="div-adaptiv mx-auto mb-3" style="padding-bottom:@screenFormat">

                    @* Video -JS *@
                    @if (Model.CurrentVideoHost == Model.FilmContentUrl)
                    {
                        <video id="my-video"
                               class="video-js video-adaptiv px-1"
                               controls
                               preload="auto"
                               width="@Model.FilmWidth"
                               height="@Model.FilmHeight"
                               poster="@posterForVideo"
                               data-setup="{}">

                            <source src="@Model.CurrentVideoHost" type="@Model.FilmMimeType" />

                            <p class="vjs-no-js">
                                To view this video please enable JavaScript, and consider upgrading to a web browser that
                                <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
                            </p>

                        </video>

                        <script src="https://vjs.zencdn.net/8.23.7/video.min.js"></script>

                        <script>
                                                var player = videojs('playerId', {
                                                    html5: {
                                                        vhs: {
                                                            overrideNative: true
                                                        },
                                                        nativeAudioTracks: false,
                                                        nativeVideoTracks: false
                                                    }
                                                });
                        </script>
                    }
                    else
                    {
                        <iframe class="video-adaptiv" src="@Model.CurrentVideoHost" allowfullscreen></iframe>
                    }

                </div>

                @* Списки под видео *@
                <div id="listUnderScreen" class="accordion mb-2 p-1">

                    @* Описание фильма *@
                    <div id="aboutFilm" class="accordion-item shadw">

                        <h2 id="headingAboutFilm" class="accordion-header shadw">

                            <button class="accordion-button collapsed p-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#blockAboutFilm"
                                    aria-expanded="true"
                                    aria-controls="blockAboutFilm">

                                <div>

                                    Содержание:

                                    <span id="descr">
                                        @Model.FilmDescriptionForSchemaOrg.StartOfDescription()
                                    </span>

                                </div>

                            </button>

                        </h2>

                        <div id="blockAboutFilm"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingAboutFilm"
                             data-bs-parent="#listUnderScreen">

                            <div id="accordionBodyAboutFilm" class="accordion-body">

                                @Html.Raw(Model.FilmDescriptionHtml)

                            </div>

                        </div>

                    </div>

                    @* Выбрать видеохостинг *@
                    <div id="chooseHost" class="accordion-item shadw mt-3">

                        <h2 id="headingChooseHost" class="accordion-header shadw">

                            <button class="accordion-button collapsed p-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#blockChooseHost"
                                    aria-expanded="true"
                                    aria-controls="blockChooseHost">

                                <span class="d-none d-sm-block pe-1">
                                    Видео на :
                                </span>

                                @* YouTube *@
                                <vc:view-image image-id="@DataConfig.YoutubeImage"
                                               css-class="maxwidth40px p-1 me-1 @(Context.Request.QueryString.ToString().Contains("yt", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* VkVideo *@
                                <vc:view-image image-id="@DataConfig.VkVideoImage"
                                               css-class="maxwidth40px p-1 me-1 @(Context.Request.QueryString.ToString().Contains("vk", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* MailRuVideo *@
                                <vc:view-image image-id="@DataConfig.MailRuVideoImage"
                                               css-class="maxwidth40px p-1 me-1 @(Context.Request.QueryString.ToString().Contains("ml", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* OkVideo *@
                                <vc:view-image image-id="@DataConfig.OkVideoImage"
                                               css-class="maxwidth40px p-1 me-1 @(Context.Request.QueryString.ToString().Contains("ok", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* AsusVideo *@
                                <vc:view-image image-id="@DataConfig.AsusVideoImage"
                                               css-class="maxwidth40px p-1 me-1 @(Context.Request.QueryString.ToString().Contains("ss", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                               icon-type="webicon100" />

                                @* YandexDisk *@
                                <vc:view-image image-id="@DataConfig.DownloadFilmImage"
                                               css-class="maxwidth40px p-1"
                                               icon-type="webicon100" />

                            </button>

                        </h2>

                        <div id="blockChooseHost"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingChooseHost"
                             data-bs-parent="#listUnderScreen">

                            <div id="accordionBodyChooseHost" class="accordion-body accordion-body-nointend">

                                <div id="hostOptions" class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                    @* YouTube *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="yt">

                                        <vc:view-image image-id="@DataConfig.YoutubeImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("yt", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* vk.com *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="vk">

                                        <vc:view-image image-id="@DataConfig.VkVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("vk", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @*mail.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ml">

                                        <vc:view-image image-id="@DataConfig.MailRuVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ml", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* ok.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ok">

                                        <vc:view-image image-id="@DataConfig.OkVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ok", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* sergeyshef.ru *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="Film"
                                       asp-route-filmCaption="@Model.FilmCaption"
                                       asp-route-host="ss">

                                        <vc:view-image image-id="@DataConfig.AsusVideoImage"
                                                       css-class="col shadw imageref @(Context.Request.QueryString.ToString().Contains("ss", StringComparison.InvariantCultureIgnoreCase) ? "setimage_border" : string.Empty)"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* Download *@
                                    <a asp-area=""
                                       asp-controller="Films"
                                       asp-action="DownloadFilm"
                                       asp-route-filmFileName="@Model.FilmFileName">

                                        <vc:view-image image-id="@DataConfig.DownloadFilmImage"
                                                       css-class="col shadw imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Информация о фильме *@
                    <div id="internerInfo" class="@((Model.FilmKinoTeatrRu != null || Model.FilmKinoPoisk != null || Model.FilmImbd != null) ? "accordion-item shadw mt-3" : "d-none")">

                        <h2 id="headingInternerInfo" class="accordion-header shadw">

                            <button class="accordion-button collapsed p-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#blockInternerInfo"
                                    aria-expanded="true"
                                    aria-controls="blockInternerInfo">

                                <span class="d-none d-sm-block pe-1">
                                    О фильме :
                                </span>

                                @* Kino-Teatr.Ru *@
                                <vc:view-image image-id="@DataConfig.KinoTeatrImage"
                                               css-class="maxwidth40px p-0 me-2"
                                               icon-type="webicon100" />

                                @* Kinopoisk.Ru *@
                                <vc:view-image image-id="@DataConfig.KinopoiskImage"
                                               css-class="maxwidth40px p-0 me-2"
                                               icon-type="webicon100" />

                                @* IMDB.com *@
                                <vc:view-image image-id="@DataConfig.ImdbImage"
                                               css-class="maxwidth40px p-0"
                                               icon-type="webicon100" />

                            </button>

                        </h2>

                        <div id="blockInternerInfo"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingInternerInfo"
                             data-bs-parent="#listUnderScreen">

                            <div id="accordionBodyInternerInfo" class="accordion-body accordion-body-nointend">

                                <div class="row row-cols-3 g-1 g-sm-2 justify-content-center">

                                    @* Kino-Teatr.Ru *@
                                    <a onClick="this.target='_blank'" href="@Model.FilmKinoTeatrRu">

                                        <vc:view-image image-id="@DataConfig.KinoTeatrImage"
                                                       css-class="col-12 shadw imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* Kinopoisk.Ru *@
                                    <a onClick="this.target='_blank'" href="@Model.FilmKinoPoisk">

                                        <vc:view-image image-id="@DataConfig.KinopoiskImage"
                                                       css-class="col-12 shadw imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                    @* IMDB.com *@
                                    <a onClick="this.target='_blank'" href="@Model.FilmImbd">

                                        <vc:view-image image-id="@DataConfig.ImdbImage"
                                                       css-class="col-12 shadw imageref"
                                                       icon-type="webicon300" />

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Полная версия фильма *@
                    <div id="fullVersion" class="@(Model.FullFilmId != null ? "accordion-item shadw mt-3" : "d-none")">

                        <h2 id="headingfullVersion" class="accordion-header shadw">

                            <button class="accordion-button collapsed p-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#blockFullVersion"
                                    aria-expanded="true"
                                    aria-controls="blockFullVersion">

                                <span class="d-none d-sm-block pe-1">
                                    Полная версия :
                                </span>

                                @if (Model.FullFilm != null)
                                {
                                    <vc:view-image image-id="@Model.FullFilm.FilmImageId"
                                                   css-class="maxwidth40px p-0 me-2"
                                                   icon-type="webicon100" />
                                }

                            </button>

                        </h2>

                        <div id="blockFullVersion"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingfullVersion"
                             data-bs-parent="#listUnderScreen">

                            <div id="accordionBodyFullVersion" class="accordion-body accordion-body-nointend bg-info mt-1">

                                <div id="accordionBodyFullVersion" class="accordion-body">

                                    @if (@Model.FullFilm != null)
                                    {
                                        <div class="row justify-content-center">

                                            <partial name="_LinkToFilmPartial" model="@Model.FullFilm" />

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Кадры фильма *@
                    <div id="filmStills" class="@((Model.ListOfPictures != null && Model.ListOfPictures.Count > 0) ? "accordion-item shadw mt-3" : "d-none")">

                        @* заголовок группы «кадры фильма» *@
                        <h2 id="headingfilmStills" class="accordion-header shadw">

                            <button class="accordion-button collapsed py-1 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#blockFilmStills"
                                    aria-expanded="true"
                                    aria-controls="blockFilmStills">

                                <span class="d-none d-sm-block pe-1">
                                    Кадры фильма :
                                </span>

                                @if (Model.ListOfPictures != null && Model.ListOfPictures.Count > 0)
                                {
                                    @do
                                    {
                                        Random rnd = new();
                                        int rndIndex = rnd.Next(Model.ListOfPictures.Count);

                                        <vc:view-image image-id="@Model.ListOfPictures[rndIndex].ImageFileModelId"
                                                       css-class="maxwidth40px p-0 me-2"
                                                       icon-type="webicon100" />
                                        n++;
                                    }
                                    while (n < Model.ListOfPictures.Count && n < 5);
                                }

                            </button>

                        </h2>

                        <div id="blockFilmStills"
                             class="accordion-collapse collapse"
                             aria-labelledby="heading4"
                             data-bs-parent="#movieDescription">

                            <div id="accordionBodyFilmStills" class="accordion-body accordion-body-nointend p-0 pt-2">

                                <div class="row row-cols-2 row-cols-sm-4 row-cols-md-5 row-cols-lg-6 g-4 pb-2 justify-content-center">

                                    @if (Model.ListOfPictures != null)
                                    {

                                        @foreach (var item in Model.ListOfPictures)
                                        {
                                            <a asp-area=""
                                               asp-controller="Films"
                                               asp-action="FilmPhotoAlbum"
                                               asp-route-imageId="@item.ImageFileModelId"
                                               asp-route-filmCaption="@(Model.FilmForPictureAround == null ? Model.FilmCaption : Model.FilmForPictureAround.FilmCaption)"
                                               class="col w-auto rounded-3 text-center">

                                                <vc:view-image image-id="@item.ImageFileModelId.ToString()"
                                                               css-class="rounded-3 shadw imageref"
                                                               icon-type="webicon100" />
                                            </a>
                                        }
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    @* кадры справа *@
    <div id="rightPictures" class="d-none d-md-block col-md-2 mx-auto overflow-y-auto overflow-x-hidden foto-around">

        @foreach (var item in Model.FramesOnTheRight)
        {
            <a asp-area=""
               asp-controller="Films"
               asp-action="FilmPhotoAlbum"
               asp-route-imageId="@item.ImageFileModelId"
               asp-route-filmCaption="@(Model.FilmForPictureAround == null ? Model.FilmCaption : Model.FilmForPictureAround.FilmCaption)"
               class=""
               title="@item.ImageAltTitle">

                <vc:view-image image-id="@item.ImageFileModelId"
                               css-class="my-2 w-100 shadw imageref"
                               icon-type="webicon200" />

            </a>
        }

    </div>

    @* Фотокарусель кадров из видео *@
    <div id="fotoCarousel">

        <vc:film-picture-carousel caption-for-picture-carousel="@(Model.FilmForPictureAround == null ? Model.FilmCaption : Model.FilmForPictureAround.FilmCaption)" />

    </div>

</div>