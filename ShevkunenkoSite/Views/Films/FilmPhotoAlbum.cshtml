@model PhotoAlbumViewModel

@* Заголовок *@
<div class="row bg-secondary-subtle block-shadow mb-3 mx-0">

    <h1 class="col h2 text_shadow mb-0 py-1">

        @Model.CaptionOfAlbum.Replace("--", " ").ToUpperInvariant()

        @if (Model.NoteForCaptionOfAlbum != null)
        {
            <br />

            <span class="h2">
                (@Model.NoteForCaptionOfAlbum)
            </span>
        }

    </h1>

</div>

@* Просмотр страницы альбома *@
@if (Model.AlbumOrPhoto)
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xxl-6 g-2 justify-content-center mb-3">

        @foreach (var imageItem in Model.ItemsOnPage)
        {
            <div class="col p-sm-1 p-0 rounded-3 block-shadow borderforitem">

                <a asp-area=""
                   asp-controller="Films"
                   asp-action="FilmPhotoAlbum"
                   asp-route-filmCaption="@Model.CaptionOfAlbum"
                   asp-route-imageId="@imageItem.ImageFileModelId"
                   title="смотреть фото">

                    <vc:view-image image-id="@imageItem.ImageFileModelId"
                                   css-class=""
                                   icon-type="webicon300" />

                </a>

            </div>
        }

    </div>
}
else
{
    @* Просмотр картинки *@
    <div class="row py-2 justify-content-center">

        <div class="col col-lg-11 col-xl-10 maxwidth900px">

            <div id="fotoAlbumCarousel" class="carousel slide carousel-dark rounded-3 pb-0 pb-sm-1 pb-lg-2 pb-xl-3 block-shadow">

                <div class="carousel-indicators pb-0 pb-sm-2 pb-lg-3 pb-xl-4">

                    @{
                        var items = Model.ItemsOnPage;
                    }

                    @for (int k = 0; k < items.Length; k++)
                    {
                        var picture = items[k];

                        if (Model.CurrentImageId == picture.ImageFileModelId)
                        {
                            <button type="button"
                                    data-bs-target="#fotoAlbumCarousel"
                                    data-bs-slide-to="@k"
                                    class="active width9percent"
                                    aria-current="true"
                                    aria-label="Фото @k">

                                <vc:view-image image-id="@picture.ImageFileModelId"
                                               css-class="d-block mx-auto imageref p-0"
                                               icon-type="" />

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    data-bs-target="#fotoAlbumCarousel"
                                    data-bs-slide-to="@k"
                                    class="width9percent"
                                    aria-label="Фото @k">

                                <vc:view-image image-id="@picture.ImageFileModelId"
                                               css-class="d-block mx-auto imageref p-0"
                                               icon-type="" />
                            </button>
                        }
                    }

                </div>

                <div class="carousel-inner pb-5">

                    @foreach (var picture in Model.ItemsOnPage)
                    {
                        @if (Model.CurrentImageId == picture.ImageFileModelId)
                        {
                            <div class="carousel-item active p-1 rounded-3 block-shadow">

                                <vc:view-image image-id=@picture.ImageFileModelId
                                               css-class="d-block mx-auto"
                                               icon-type="" />

                                <p class="d-none d-md-block fs-4 mt-3 text_shadow maxwidth700px mx-auto">
                                    @picture.ImageDescription.TrimEnd('.')
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="carousel-item p-1 rounded-3 block-shadow">

                                <vc:view-image image-id=@picture.ImageFileModelId
                                               css-class="d-block mx-auto"
                                               icon-type="" />

                                <p class="d-none d-md-block fs-4 mt-3 text_shadow maxwidth700px mx-auto">

                                    @picture.ImageDescription

                                </p>

                            </div>
                        }
                    }

                </div>

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#fotoAlbumCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon" aria-hidden="true">

                    </span>

                    <span class="visually-hidden">
                        Previous
                    </span>

                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#fotoAlbumCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon" aria-hidden="true">

                    </span>

                    <span class="visually-hidden">
                        Next
                    </span>

                </button>

            </div>

        </div>

    </div>
}

@* Страницы альбома *@
<h2 class="text_shadow fs-3 p-0 mt-2">

    страницы альбома

</h2>

<div pagination="@Model"
     album-caption="@Model.CaptionOfAlbum"
     data-toggle="buttons"
     role="group"
     aria-label="фотоальбом">
</div>

<vc:film-picture-carousel caption-for-picture-carousel="@Model.CaptionOfAlbum" />

<hr class="liniya" />