@model IconModel[]

@{
    string trStyle = string.Empty;

    string btnStyle = "btn px-1 py-0 m-1 shadw minwidth40px";

    string delBtn = string.Empty;

    IconModel currentIcon;

    Guid currentId;

    if (Guid.TryParse(Context.Request.Query["iconId"], out currentId)
        && Model.Where(icon => icon.IconModelId == currentId).Any())
    {
        currentIcon = Model.First(icon => icon.IconModelId == currentId);
    }
    else
    {
        currentIcon = Model[0];
    }
}

<p class="fs-4">
    <span class="fw-bold text-primary">
        Каталог иконок:
    </span>
    <span class="text_shadow">
        @currentIcon.IconType.PathToIcon.TrimEnd('/')
    </span>
</p>

<p class="fs-4">
    <span class="fw-bold text-primary">
        Количество иконок:
    </span>
    <span class="text_shadow">
        @Model.Length
    </span>
</p>

<hr class="w-50 mx-auto" />

<img class="maxwidth300px mt-2"
     src="@DataConfig.IconsFolder@currentIcon.IconType.PathToIcon@currentIcon.IconFileName"
     title="@DataConfig.IconsFolder@currentIcon.IconType.PathToIcon@currentIcon.IconFileName"
     alt="@DataConfig.IconsFolder@currentIcon.IconType.PathToIcon@currentIcon.IconFileName" />

<p class="fs-4 text_shadow mt-2">
    @currentIcon.IconFileName
</p>

<hr class="w-50 mx-auto" />

<div class="text-center">

    @* Типы иконок *@
    <a asp-area="Admin"
       asp-controller="IconType"
       asp-action="Index"
       class="btn btn-outline-primary shadw py-1 me-5 minwidth100px"
       title="типы иконок">

        Иконки

    </a>

    @* Добавить иконку *@
    <a asp-area="Admin"
       asp-controller="Icon"
       asp-action="AddIcon"
       asp-route-iconId="@currentIcon.IconTypeModelId"
       class="btn btn-outline-danger shadw py-1 minwidth100px"
       title="добавить иконку">

        Добавить

    </a>

</div>

<hr class="w-50 mx-auto" />

<div class="table-responsive">

    <table class="table table-sm table-hover caption-top align-middle fs-5">

        <thead>

            <tr class="text-start">

                <th scope="col" class="text-primary border border-black border-end-2 border-start-0 border-top-0 border-bottom-0">
                    Icon
                </th>

                <th scope="col" class="text-primary border border-black border-end-2 border-start-0 border-top-0 border-bottom-0">
                    File
                </th>

                <th scope="col" class="text-primary d-none d-sm-table-cell border border-black border-end-2 border-start-0 border-top-0 border-bottom-0">
                    Size
                </th>

                <th scope="col" class="text-primary d-none d-md-table-cell border border-black border-end-2 border-start-0 border-top-0 border-bottom-0">
                    Rel
                </th>

                <th scope="col" class="text-primary d-none d-lg-table-cell border border-black border-end-2 border-start-0 border-top-0 border-bottom-0">
                    Purpose
                </th>

                <th scope="col"></th>

            </tr>

        </thead>

        <tbody>

            @foreach (var iconItem in Model)
            {
                if (iconItem.IconModelId == currentId)
                {
                    trStyle = "table-primary";
                }
                else
                {
                    trStyle = string.Empty;
                }

                if (iconItem.IconFileName.Contains("ms-tile-558."))
                {
                    delBtn = "d-none";
                }
                else
                {
                    delBtn = string.Empty;
                }

                <tr class="text-start @trStyle">

                    <td scope="col">

                        <img class="maxwidth40px"
                             src="@DataConfig.IconsFolder@iconItem.IconType.PathToIcon@iconItem.IconFileName"
                             title="@DataConfig.IconsFolder@iconItem.IconType.PathToIcon@iconItem.IconFileName"
                             alt="@DataConfig.IconsFolder@iconItem.IconType.PathToIcon@iconItem.IconFileName" />

                    </td>

                    <td scope="col">

                        @iconItem.IconFileName

                    </td>

                    <td scope="col" class="d-none d-sm-table-cell">

                        @iconItem.IconSize

                    </td>

                    <td scope="col" class="d-none d-md-table-cell">

                        @iconItem.RelForIcon

                    </td>

                    <td scope="col" class="d-none d-lg-table-cell">

                        @iconItem.IconPurpose

                    </td>

                    <td scope="col" class="text-center">

                        <a asp-area="Admin"
                           asp-controller="Icon"
                           asp-action="Index"
                           asp-route-iconId="@iconItem.IconModelId"
                           class="@btnStyle btn-outline-info"
                           title="подробно">

                            Info

                        </a>

                        <a asp-area="Admin"
                           asp-controller="Icon"
                           asp-action="EditIcon"
                           asp-route-iconId="@iconItem.IconModelId"
                           class="@btnStyle btn-outline-success"
                           title="редактировать">

                            Edit

                        </a>

                        <a asp-area="Admin"
                           asp-controller="Icon"
                           asp-action="DeleteIcon"
                           asp-route-iconId="@iconItem.IconModelId"
                           class="@btnStyle btn-outline-danger @delBtn"
                           title="удалить">

                            Del

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>