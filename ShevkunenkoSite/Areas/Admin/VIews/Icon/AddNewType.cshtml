@model IconModel

@{
    string cssForLabel = "col-form-label text-primary fs-5 me-2";
}

<h1 class="fs-3 text_shadow mb-3">Новый тип иконки</h1>

<div class="row">

    <div class="col col-lg-9 col-xl-8 d-block mx-auto px-2">

        <form asp-area="Admin"
              asp-controller="Icon"
              asp-action="AddIcon"
              method="post"
              enctype="multipart/form-data">

            @* скрытые  поля *@
            <div>

                <input asp-for="NewIcon" type="hidden" value=@true />

            </div>


            @* все ошибки ввода данных *@
            @if (Context.Request.Method == "POST")
            {
                <div asp-validation-summary="All" class="text-danger border border-top-0 border-danger mb-3"></div>
            }

            @* данные по группам *@
            <div class="accordion" id="accordionAddIcon">

                @* Выбор файла иконки *@
                <div class="accordion-item mb-3 mt-2 shadw">

                    @* заголовок группы «выбор файла иконки» *@
                    <h2 id="headingChoiceFile" class="accordion-header">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#ChoiceFile"
                                aria-expanded="true"
                                aria-controls="ChoiceFile">

                            <span class="form-label fs-5">
                                Выбор файла иконки :
                            </span>

                        </button>

                    </h2>

                    @* выбрать картинку *@
                    <div id="ChoiceFile"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingChoiceFile"
                         data-bs-parent="#accordionAddIcon">

                        <div class="accordion-body accordion-body-nointend text-center">

                            <div>

                                <label asp-for="IconFileFormFile" class="@cssForLabel"></label>

                                <input asp-for="IconFileFormFile"
                                       id="IconFormFileInput"
                                       class="form-control mt-2 w-50 mx-auto"
                                       aria-describedby="IconFormFileInputHelpBlock" />

                                @if (Context.Request.Method == "POST")
                                {
                                    <span asp-validation-for="IconFileFormFile" class="text-danger"></span>
                                }

                                <div id="IcinFormFileInputHelpBlock" class="form-text mt-3">

                                    <span class="fs-6 text-success">
                                        выбрать файл иконки
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                @* Создать каталог иконки *@
                <div class="accordion-item mb-3 mt-2 shadw">

                    @* заголовок группы «создать каталог иконки» *@
                    <h2 id="headingChoiceFile" class="accordion-header">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#ChoicePath"
                                aria-expanded="true"
                                aria-controls="ChoicePath">

                            <span class="form-label fs-5">
                                Создать папку иконки :
                            </span>

                        </button>

                    </h2>

                    @* создать каталог *@
                    <div id="ChoicePath"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingChoicePath"
                         data-bs-parent="#accordionAddIcon">

                        <div class="accordion-body accordion-body-nointend text-center">

                            @* Новый каталог для иконки *@
                            <div class="row g-2 justify-content-center">

                                <div class="col-auto">
                                    <label asp-for="NewIconPath" class="@cssForLabel"></label>
                                </div>

                                <div class="col-auto">
                                    <input asp-for="NewIconPath"
                                           id="NewImagePathInput"
                                           class="form-control text-center"
                                           aria-describedby="NewIconPathInputHelpBlock" />
                                </div>

                                <div id="NewIconPathInputHelpBlock" class="form-text">

                                    <span class="fs-6 text-success">
                                        новый каталог
                                    </span>

                                </div>

                                <span asp-validation-for="NewIconPath" class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            @* Сохранить - Отменить*@
            <div class="card-footer p-0 pb-2 mt-4 mx-auto maxwidth700px">

                <button type="submit"
                        class="btn btn-outline-success m-2 me-3 text-center shadw"
                        title="Сохранить">

                    Сохранить

                </button>

                <a class="btn btn-outline-danger m-2 shadw"
                   asp-area="Admin"
                   asp-controller="Icon"
                   asp-action="Index"
                   title="отменить">

                    Отменить

                </a>

            </div>

        </form>

    </div>

</div>