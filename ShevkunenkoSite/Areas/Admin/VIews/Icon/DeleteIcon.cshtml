@model IconModel

@{
}

<h1 class="fs-3 text_shadow mb-3">
    Удалить  иконку
</h1>

<hr class="w-50 mx-auto" />

<img class="maxwidth300px mt-2"
     src="@DataConfig.IconsFolder@Model.IconType.PathToIcon@Model.IconFileName"
     title="@DataConfig.IconsFolder@Model.IconType.PathToIcon@Model.IconFileName"
     alt="@DataConfig.IconsFolder@Model.IconType.PathToIcon@Model.IconFileName" />

<p class="fs-4 text_shadow mt-2">
    @Model.IconFileName
</p>

<hr class="w-50 mx-auto" />

<p class="fs-4 text-danger-emphasis text-indent-0 text-info">Иконка будет перемещена в папку «Temp»</p>

<hr class="w-50 mx-auto" />

<form asp-area="Admin"
      asp-controller="Icon"
      asp-action="DeleteIcon"
      method="post"
      enctype="multipart/form-data">

    @* скрытые  поля *@
    <div>

        <input asp-for="IconModelId" type="hidden" value=@Model.IconModelId />

    </div>


    @* Удалить - Отменить*@
    <div class="card-footer p-0 pb-2 mt-4 mx-auto maxwidth700px">

        <button type="submit"
                class="btn btn-outline-success m-2 me-3 text-center shadw minwidth100px"
                title="удалить">

            Удалить

        </button>

        <a class="btn btn-outline-danger m-2 shadw minwidth100px"
           asp-area="Admin"
           asp-controller="Icon"
           asp-action="Index"
           asp-route-iconId="@Model.IconModelId"
           title="отменить">

            Отменить

        </a>

    </div>

</form>



