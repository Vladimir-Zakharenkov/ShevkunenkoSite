@model ItemsListViewModel

@* Значение строки поиска *@
<div>

    @if (Model.TotalItems == 0)
    {
        <div class="row">

            <div class="col text-center p-2">

                <p class="fs-5 text_shadow mb-0">

                    @(string.IsNullOrWhiteSpace(Model.SearchString)
                        ? "В базе данных нет страниц"
                        : "По вашему запросу страницы не найдены")

                </p>

            </div>

        </div>
    }

</div>

@* Сообщение о количестве страниц *@
<div>

    @if (Model.TotalItems > 0)
    {
        <div class="row">

            <div class="col-12 text-center">

                <p class="fs-5 text-primary mb-0">
                    Количество страниц :&nbsp;
                    <span class="text-black text_shadow">
                        @Model.TotalItems
                    </span>
                </p>

            </div>

        </div>
    }

    <hr class="liniya" />

</div>

@* Добавить страницу - Иконки страниц - Поиск страницы *@
<div class="row">

    @* Добавить страницу - Иконки страниц *@
    <div class="col-12 col-md-6 col-lg-4">

        @* Добавить страницу *@
        <a asp-area="Admin"
           asp-controller="PageInfo"
           asp-action="AddPage"
           class="btn btn-outline-danger block-shadow py-1 mt-2 me-3 minwidth100px"
           title="добавить страницу">

            Добавить

        </a>

        @* Иконки страниц *@
        <a asp-area="Admin"
           asp-controller="PageInfo"
           asp-action="Index"
           asp-route-searchString="@Model.SearchString"
           asp-route-pageCard="true"
           class="btn btn-outline-primary block-shadow py-1 mt-2 minwidth100px"
           title="карточки страниц">

            Иконки

        </a>

    </div>

    <hr class="col-12 w-75 mt-3 d-md-none mx-auto" />

    @* Поиск страницы *@
    <div class="col-12 col-md-6 col-lg-8 mb-2">

		
        <form method="get"
              asp-area="Admin"
              asp-controller="PageInfo"
              asp-action="Index"
              class="text-center text-md-end mt-md-2">

            <input type="hidden"
                   name="pageCard"
                   value="false" />

            <input asp-for="SearchString"
                   class="d-inline-block align-middle mt-1 w-50"
                   type="search"
                   aria-label="Поиск страницы" />

            <button type="submit"
                    class="btn btn-outline-success block-shadow py-1 me-md-3">

                Поиск

            </button>

        </form>

    </div>

    <hr class="liniya" />

</div>

@* Таблица данных *@
<div class="row mb-3">

    <div class="col-12">

        <div class="table-responsive block-shadow">

            <table class="table table-sm table-hover align-middle">

                <thead class="table-secondary">

                    <tr>
                        <th scope="col">
                            Заголовок
                        </th>
                        <th scope="col" class="d-none d-xl-table-cell">
                            Адрес
                        </th>
                        <th scope="col" class="text-center">
                            Действия
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var pageInfo in Model.AllSitePages
                        ?? Array.Empty<PageInfoModel>())
                    {
                        <tr>

                            <td class="text-start text_shadow">
                                @pageInfo.PageTitle
                            </td>
                            <td class="d-none d-xl-table-cell text-start text_shadow">
                                @pageInfo.PageFullPathWithData
                            </td>
                            <td class="text-center">

                                <div class="d-flex flex-wrap
                                    justify-content-center gap-1">

                                    <a asp-area="Admin"
                                       asp-controller="PageInfo"
                                       asp-action="DetailsPage"
                                       asp-route-pageId="@pageInfo.PageInfoModelId"
                                       class="btn btn-outline-info btn-sm">

                                        Info

                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="PageInfo"
                                       asp-action="EditPage"
                                       asp-route-pageId="@pageInfo.PageInfoModelId"
                                       class="btn btn-outline-dark btn-sm">

                                        Edit

                                    </a>

                                    <a href="@Url.Content(pageInfo.PageFullPathWithData)"
                                       class="btn btn-outline-primary btn-sm">

                                        Run

                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="PageInfo"
                                       asp-action="DeletePage"
                                       asp-route-pageId="@pageInfo.PageInfoModelId"
                                       class="btn btn-outline-danger btn-sm">

                                        Del

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@* Разбивка на страницы *@
@if (Model.TotalPages > 1)
{
    <div pagination="@Model"></div>
}