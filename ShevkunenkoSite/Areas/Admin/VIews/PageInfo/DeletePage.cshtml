@model PageInfoModel

<div class="row">

    <div class="col col-lg-9 col-xl-7 col-xxl-6 d-block mx-auto px-2">

        <hr class="liniya" />

        <h1 class="fs-3 text_shadow">Удалить страницу</h1>

        <div class="mx-auto maxwidth300px">

            <vc:card-of-page page="@Model" />

        </div>

        <hr class="liniya" />

        <div class="card p-2">

            @if (!string.IsNullOrEmpty(Model.RoutData))
            {
                <p class="fs-5 text-danger mb-0">
                    (<span class="text-black">«@Model.PageFullPathWithData»</span>)
                </p>
            }
            else
            {
                <p class="fs-5 text-danger mb-0">
                    (<span class="text-black">«@Model.PageFullPath»</span>)
                </p>
            }

            <div class="card-body mx-0 p-0">

                <form method="post" class="mt-2">

                    @* все ошибки ввода данных *@
                    @if (Context.Request.Method == "POST")
                    {
                        <div asp-validation-summary="All" class="text-danger border border-top-0 border-danger mb-3"></div>
                    }

                    <input asp-for="PageInfoModelId" type="hidden" value="@Model.PageInfoModelId" />

                    <div class="card-footer p-2">

                        <button type="submit"
                                class="btn btn-outline-danger me-2 shadw"
                                title="удалить страницу">

                            Delete

                        </button>

                        <a asp-area="Admin"
                           asp-controller="PageInfo"
                           asp-action="Index"
                           class="btn btn-outline-success shadw"
                           title="не удалять">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>