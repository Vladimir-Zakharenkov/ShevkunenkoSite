                                    <label asp-for="PosterForFilmFormFile" class="@cssForLabel"></label>

                                </div>

                                <div class="col-auto text-start">

                                    <input asp-for="PosterForFilmFormFile"
                                           id="PosterForMovieFormFileInput"
                                           class="form-control"
                                           aria-describedby="PosterForFilmFormFileInputHelpBlock" />

                                </div>

                                <div id="PosterForFilmFormFileInputHelpBlock" class="form-text">

                                    <span class="fs-6 text-success">
                                        постер для фильма -
                                    </span>
                                    <br class="d-inline-block d-xl-none" />
                                    <span class="fs-6 text-danger">
                                        обязательное поле
                                    </span>

                                </div>

                                @if (Context.Request.Method == "POST")
                                {
                                    <span class="text-danger preline">@Html.ValidationMessageFor(model => model.PosterForFilmFormFile)</span>
                                }

                            </div>

                            @* Выбрать картинку фильма *@
                            <div id="pictureInput" class="row g-2 justify-content-center">

                                <div class="col-auto">

                                    <label asp-for="ImageForFilmFormFile" class="@cssForLabel"></label>

                                </div>

                                <div class="col-auto text-start">

                                    <input asp-for="ImageForFilmFormFile"
                                           id="ImageForMovieFormFileInput"
                                           class="form-control"
                                           aria-describedby="ImageForFilmFormFileInputHelpBlock" />

                                </div>

                                <div id="ImageForFilmFormFileInputHelpBlock" class="form-text">

                                    <span class="fs-6 text-success">
                                        картинка для фильму -
                                    </span>
                                    <br class="d-inline-block d-xl-none" />
                                    <span class="fs-6 text-danger">
                                        обязательное поле
                                    </span>

                                </div>

                                @if (Context.Request.Method == "POST")
                                {
                                    <span asp-validation-for="ImageForFilmFormFile" class="text-danger"></span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            @* Сохранить - Отменить*@
            <div class="card-footer p-0 pb-2 mt-4 mx-auto maxwidth700px">

                <button type="submit"
                        class="btn btn-outline-success m-2 me-3 text-center shadw"
                        title="Сохранить">

                    Сохранить

                </button>

                <a class="btn btn-outline-danger m-2 shadw"
                   asp-area="Admin"
                   asp-controller="Films"
                   asp-action="Index"
                   title="отменить">

                    Отменить

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script src="~/js/ckeditor5/ckeditor.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function (event) {
            ClassicEditor.create(document.querySelector('#FilmDescriptionHtmlInput'));
        });
    </script>
}