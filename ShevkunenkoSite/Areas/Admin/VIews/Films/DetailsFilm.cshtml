@model FilmFileModel

<h1 class="fs-3 text-primary my-3">
    Информация о фильме
</h1>

<hr class="liniya w-50" />

@* Название фильма *@
<div>

    <h1 class="fs-5 lh-base">

        <span class="fs-3 text_shadow">
            @Model.FilmCaption
        </span>

        <br />

        <span class="fs-6 form-text text-success px-2">
            название фильма
        </span>

    </h1>

    @if (!string.IsNullOrEmpty(Model.FilmCaptionOriginal))
    {
        <h2 class="fs-5 lh-base">

            <span class="fs-3 text_shadow">
                @Model.FilmCaptionOriginal
            </span>

            <br />

            <span class="fs-6 form-text text-success px-2">
                оригинальное название фильма
            </span>

        </h2>
    }

</div>

@* Идентификатор в базе данных *@
<h2 class="fs-5 lh-base">
    <span class="text_shadow">
        @Model.FilmFileModelId
    </span>

    <br />

    <span class="fs-6 form-text text-success">
        идентификатор в базе данных (GUID)
    </span>
</h2>

<hr class="liniya w-50" />

<div class="row">

    @* кадры слева *@
    <div class="d-none d-md-block col-md-2 mx-auto overflow-y-auto overflow-x-hidden foto-around">

        @foreach (var item in Model.FramesOnTheLeft)
        {
            <a asp-area=""
               asp-controller="Films"
               asp-action="FilmPhotoAlbum"
               asp-route-imageId="@item.ImageFileModelId"
               asp-route-filmCaption="@(Model.FilmForPictureAround != null ? Model.FilmForPictureAround.FilmCaption : Model.FilmCaption)"
               title="@item.ImageAltTitle"
               class="">

                <vc:view-image image-id="@item.ImageFileModelId"
                               css-class="my-2 w-100 shadw imageref"
                               icon-type="webicon200" />

            </a>
        }

    </div>

    @* Информация по разделам *@
    <div class="col-12 col-md-8 mb-3">

        @* Изменить, удалить, смотреть, список *@
        <div class="card-footer p-0 my-2">

            @* Изменить *@
            <a asp-area="Admin"
               asp-controller="Films"
               asp-action="EditFilm"
               asp-route-filmId="@Model.FilmFileModelId"
               class="btn btn-outline-success py-1 px-0 m-2 shadw width80px"
               title="изменить данные">

                Изменить

            </a>

            @* Удалить *@
            <a asp-area="Admin"
               asp-controller="Films"
               asp-action="DeleteFilm"
               asp-route-filmId="@Model.FilmFileModelId"
               class="btn btn-outline-danger py-1 px-0 m-2 shadw width80px"
               title="удалить фильм">

                Удалить

            </a>

            @* Список фильмов сайта *@
            <a asp-area="Admin"
               asp-controller="Films"
               asp-action="Index"
               class="btn btn-outline-primary py-1 px-0 m-2 shadw width80px"
               title="список фильмов">

                Список

            </a>

            <a asp-area=""
               asp-controller="Films"
               asp-action="Film"
               asp-route-filmCaption="@Model.FilmCaption"
               asp-route-videoHosting="ss"
               class="btn btn-outline-dark py-1 px-0 m-2 shadw width80px"
               title="смотреть">

                Смотреть

            </a>

        </div>

        @* Разделы информации (accordion) *@
        <div class="accordion" id="accordionDetailsFilm">

            @* Файл фильма *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «файл фильма» *@
                <h2 id="headingFilmFile" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FilmFile"
                            aria-expanded="true"
                            aria-controls="FilmFile">

                        <span class="form-label fs-5">
                            Файл фильма :
                        </span>

                    </button>
                </h2>

                <div id="FilmFile"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFilmFile"
                     data-bs-parent="#accordionDetailsFilm">

                    @* адрес файла на сайте *@
                    <div class="accordion-body accordion-body-nointend text-center fontadaptive">

                        @if (Model.FilmContentUrl != null)
                        {
                            <p class="fs-5 mb-0">

                                <span class="text_shadow">
                                    @Model.FilmContentUrl
                                </span>

                                <br />

                                <a class="btn btn-outline-primary py-0 px-2 m-2 shadw"
                                   href="@Model.FilmContentUrl"
                                   onclick="this.target='_blank'"
                                   title="sergeyshef.ru"
                                   itemprop="relatedLink">

                                    Смотреть

                                </a>

                                <br />

                                <span class="fs-6 form-text text-success px-2">
                                    адрес файла на сайте
                                </span>

                            </p>
                        }
                        else
                        {
                            <p class="fs-5 mb-0">

                                <span class="text_shadow">
                                    файл фильма отсутствует
                                </span>

                            </p>
                        }

                    </div>

                </div>

            </div>

            @* Картинка фильма *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «картинка фильма» *@
                <h2 id="headingFilmImage" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FilmImage"
                            aria-expanded="true"
                            aria-controls="FilmImage">

                        <span class="form-label fs-5">
                            Картинка фильма :
                        </span>

                    </button>
                </h2>

                <div id="FilmImage"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFilmImage"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend  text-center">

                        <vc:view-image image-id="@Model.FilmImageId"
                                       css-class="card-img-top m-2 shadw maxwidth300px"
                                       icon-type="webicon300" />

                        @if (Model.FilmImage != null && !string.IsNullOrEmpty(Model.FilmImage.WebImageFileName))
                        {
                            <p class="fs-5 mb-0 text_shadow">
                                @Model.FilmImage.ImagePath/@Model.FilmImage.WebImageFileName
                            </p>
                        }

                        @if (Model.FilmImage != null && !string.IsNullOrEmpty(Model.FilmImage.ImageFileName))
                        {
                            <p class="fs-5 mb-0 text_shadow">
                                @Model.FilmImage.ImagePath/@Model.FilmImage.ImageFileName
                            </p>
                        }

                        <a class="btn btn-outline-primary py-1 my-3 shadw"
                           asp-area="Admin"
                           asp-controller="ImageInfo"
                           asp-action="DetailsImage"
                           asp-route-imageId="@Model.FilmImageId"
                           onclick="this.target='_blank'"
                           title="данные картинки">

                            Картинка

                        </a>

                        <p>
                            <span class="fs-6 form-text text-success px-2">
                                картинка для видео
                            </span>
                        </p>

                    </div>

                </div>

            </div>

            @* Постер фильма *@
            <div class="accordion-item  mb-3 shadw">

                @* заголовок группы «постер фильма» *@
                <h2 class="accordion-header" id="headingFilmPoster">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FilmPoster"
                            aria-expanded="true"
                            aria-controls="FilmPoster">

                        <span class="form-label fs-5">
                            Постер фильма :
                        </span>

                    </button>
                </h2>

                <div id="FilmPoster"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFilmPoster"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend  text-center">

                        @if (Model.FilmPoster != null)
                        {
                            <vc:view-image image-id="@Model.FilmPosterId"
                                           css-class="card-img-top m-2 w-75 shadw maxwidth300px"
                                           icon-type="webicon300" />

                            @if (!string.IsNullOrEmpty(Model.FilmPoster.WebImageFileName))
                            {
                                <p class="fs-5 mb-0 text_shadow">
                                    @Model.FilmPoster.ImagePath/@Model.FilmPoster.WebImageFileName
                                </p>
                            }
                            else
                            {
                                <p class="fs-5 mb-0 text_shadow">
                                    @Model.FilmPoster.ImagePath/@Model.FilmPoster.ImageFileName
                                </p>
                            }

                            <a class="btn btn-outline-primary py-1 my-3 shadw"
                               asp-area="Admin"
                               asp-controller="ImageInfo"
                               asp-action="DetailsImage"
                               asp-route-imageId="@Model.FilmPosterId"
                               onclick="this.target='_blank'"
                               title="данные постера">

                                Постер

                            </a>

                            <p>

                                <span class="fs-6 form-text text-success px-2">
                                    постер для видео
                                </span>

                            </p>
                        }
                        else
                        {
                            <p class="fs-5 text_shadow">
                                постер для видео отсутствует
                            </p>
                        }

                    </div>

                </div>

            </div>

            @* Многосерийный фильм *@
            <div class="@(string.IsNullOrEmpty(Model.SeriesSearchFilter) ? "d-none" : "accordion-item mb-3 shadw")">

                @* заголовок группы «многосерийный фильм» *@
                <h2 id="headingFilmSeries" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FilmSeries"
                            aria-expanded="true"
                            aria-controls="FilmSeries">

                        <span class="form-label fs-5">
                            Многосерийный :
                        </span>

                    </button>
                </h2>

                <div id="FilmSeries"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFilmSeries"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend text-center">

                        <p class="fs-5 mb-0">

                            <span class="fw-bold text-danger">
                                Количество серий:
                            </span>

                            <span class="fw-bold text_shadow">
                                @Model.FilmTotalParts
                            </span>

                        </p>

                        <p class="fs-5 mb-0">

                            <span class="fw-bold text-danger">
                                Серия:
                            </span>

                            <span class="fw-bold text_shadow">
                                @Model.FilmPart
                            </span>

                        </p>

                        <hr class="w-50 mx-auto" />

                        <p class="fs-5 mb-0">

                            <span class="fw-bold text-danger">
                                Текст поиска серий:
                            </span>

                            <span class="text_shadow">
                                @Model.SeriesSearchFilter
                            </span>

                        </p>

                    </div>

                </div>

            </div>

            @* Описание *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «описание» *@
                <h2 class="accordion-header" id="headingDescription">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FilmDescription"
                            aria-expanded="true"
                            aria-controls="FilmDescription">

                        <span class="form-label fs-5">
                            Описание :
                        </span>

                    </button>
                </h2>

                <div id="FilmDescription"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDescription"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend">

                        <div class="card-body mx-0 p-0">

                            <ul class="list-group list-group-flush text-center">

                                @* Краткое содержание *@
                                <li class="list-group-item mt-0">

                                    @* текст TXT *@
                                    <div class="border border-1 border-secondary p-2 mb-2">

                                        <p class="text-center text-danger fw-bold fs-5">
                                            (TXT)
                                        </p>

                                        <p class="text-start">
                                            @Model.FilmDescriptionForSchemaOrg
                                        </p>

                                    </div>

                                    @* текст HTML *@
                                    <div class="border border-1 border-secondary p-2 mb-2 justify">

                                        <p class="text-center text-danger fw-bold fs-5">
                                            (HTML код)
                                        </p>

                                        @Model.FilmDescriptionHtml

                                    </div>

                                    <div class="border border-2 border-primary p-2 my-2 text-justify text-indent-2em">

                                        @Html.Raw(Model.FilmDescriptionHtml)

                                    </div>

                                    <span class="fs-6 form-text text-success px-2">
                                        краткое содержание
                                    </span>

                                    <hr class="liniya w-50" />

                                </li>

                                @* Примечания к фильму *@
                                <li class="@(string.IsNullOrEmpty(Model.FilmNote) ? "d-none" : "list-group-item")">

                                    <span class="fs-6">
                                        @Model.FilmNote
                                    </span>

                                    <br />

                                    <span class="fs-6 form-text text-success px-2">
                                        примечания к фильму
                                    </span>

                                </li>

                                @* Примечания к фильму отсутствуют *@
                                <li class="@(string.IsNullOrEmpty(Model.FilmNote) ? "list-group-item" : "d-none")">


                                    <span class="fs-6 form-text text-success px-2">
                                        примечания не заданы
                                    </span>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

            @* Размер кадра *@
            <div class="@((Model.FilmWidth == 0 && Model.FilmHeight == 0) ? "d-none" : "accordion-item mb-3 shadw")">

                @* заголовок группы «размер кадра» *@
                <h2 id="headingWidthHeight" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#WidthHeight"
                            aria-expanded="true"
                            aria-controls="WidthHeight">

                        <span class="form-label fs-5">
                            Размер кадра :
                        </span>

                    </button>
                </h2>

                <div id="WidthHeight"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingWidthHeight"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend  text-center">

                        <ul class="list-group list-group-flush text-center">

                            @* Размер кадра *@
                            <li class="list-group-item">

                                <span class="fs-5 text_shadow">
                                    @Model.FilmWidth px x @Model.FilmHeight px
                                </span>

                                <br />

                                <span class="fs-6 form-text text-success px-2">
                                    размер кадра фильма
                                </span>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

            @* Размер файла фильма *@
            <div class="@(Model.FilmFileSize > 0 ? "accordion-item mb-3 shadw" : "d-none")">

                @* заголовок группы «размер файла фильма» *@
                <h2 id="headingFileSize" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#FileSize"
                            aria-expanded="true"
                            aria-controls="FileSize">

                        <span class="form-label fs-5">
                            Размер файла фильма :
                        </span>

                    </button>
                </h2>

                <div id="FileSize"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFileSize"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend  text-center">

                        <ul class="list-group list-group-flush text-center">

                            @* Размер файла фильма *@
                            <li class="list-group-item">

                                <span class="fs-5 text_shadow">
                                    @Model.FilmFileSize.ToString("#,#") байт
                                </span>

                                <br />

                                <span class="fs-6 form-text text-success px-2">
                                    размер файла фильма
                                </span>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

            @* Продолжительность фильма *@
            <div class="@(Model.FilmDuration.Seconds != 0 ? "accordion-item mb-3 shadw" : "d-none")">

                @* заголовок группы «продолжительность» *@
                <h2 id="headingDuration" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#Duration"
                            aria-expanded="true"
                            aria-controls="Duration">

                        <span class="form-label fs-5">
                            Продолжительность :
                        </span>

                    </button>
                </h2>

                <div id="Duration"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDuration"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend text-center">

                        <ul class="list-group list-group-flush text-center">

                            @* Продолжительность фильма *@
                            <li class="list-group-item">

                                <span class="fs-5 text_shadow">
                                    @Model.FilmDuration.ToString(@"hh\:mm\:ss")
                                </span>

                                <br />

                                <span class="fs-6 form-text text-success px-2">
                                    продолжительность
                                </span>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

            @* Даты *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «даты» *@
                <h2 id="headingDate" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#Date"
                            aria-expanded="true"
                            aria-controls="Date">

                        <span class="form-label fs-5">
                            Даты :
                        </span>

                    </button>
                </h2>

                <div id="Date"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingDate"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend">

                        <div class="card-body mx-0 p-0">

                            <ul class="list-group list-group-flush text-center">

                                @* Дата создания *@
                                <li class="list-group-item">

                                    <span class="fs-5 text_shadow">
                                        @Model.FilmDateCreated.ToString("dd-MM-yyyy")
                                    </span>

                                    <br />

                                    <span class="fs-6 form-text text-success px-2">
                                        дата создания
                                    </span>

                                </li>

                                @* Дата примьеры *@
                                <li class="list-group-item">

                                    <span class="fs-5 text_shadow">
                                        @Model.FilmDatePublished.ToString("dd-MM-yyyy")
                                    </span>

                                    <br />

                                    <span class="fs-6 form-text text-success px-2">
                                        дата примьеры
                                    </span>

                                </li>

                                @* Дата публикации на сайте *@
                                <li class="list-group-item">

                                    <span class="fs-5 text_shadow">
                                        @Model.FilmUploadDate.ToString("dd-MM-yyyy")
                                    </span>

                                    <br />

                                    <span class="fs-6 form-text text-success px-2">
                                        публикация на сайте
                                    </span>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

            @* Фильтры поиска *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «фильтры поиска» *@
                <h2 id="headingFilters" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#Filters"
                            aria-expanded="true"
                            aria-controls="Filters">

                        <span class="form-label fs-5">
                            Фильтры поиска :
                        </span>

                    </button>
                </h2>

                <div id="Filters"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingFilters"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend">

                        <div class="card-body mx-0 p-0">

                            <ul class="list-group list-group-flush text-center">

                                @* Жанр фильма *@
                                <li class="list-group-item border border-0">

                                    <div class="border border-1 border-secondary p-2 text_shadow fs-6 text-start mb-2">

                                        @foreach (var filter in Model.FilmGenre.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <p># @filter.TrimEnd(',')</p>
                                        }

                                    </div>

                                    <span class="fs-6 form-text text-success px-2">
                                        жанр фильма
                                    </span>

                                    <hr class="liniya w-50" />

                                </li>

                                @* Фильтр поиска *@
                                @if (!string.IsNullOrEmpty(Model.SearchFilterForFilm))
                                {
                                    <li class="list-group-item">

                                        <div class="border border-1 border-secondary p-2 text_shadow fs-6 text-start mb-2">

                                            @foreach (var filter in Model.SearchFilterForFilm.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <p># @filter.TrimEnd(',')</p>
                                            }

                                        </div>

                                        <span class="fs-6 form-text text-success px-2">
                                            фильтры поиска
                                        </span>

                                    </li>
                                }
                                else
                                {
                                    <li class="list-group-item">

                                        <span class="fs-6 form-text text-success px-2">
                                            фильтры поиска не заданы
                                        </span>

                                    </li>
                                }

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

            @* Ограничения для просмотра *@
            <div class="accordion-item mb-3 shadw">

                @* заголовок группы «ограничения» *@
                <h2 id="headingRestrict" class="accordion-header">
                    <button class="accordion-button collapsed py-0 stranicy"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#Restrict"
                            aria-expanded="true"
                            aria-controls="Restrict">

                        <span class="form-label fs-5">
                            Ограничения :
                        </span>

                    </button>
                </h2>

                <div id="Restrict"
                     class="accordion-collapse collapse"
                     aria-labelledby="headingRestrict"
                     data-bs-parent="#accordionDetailsFilm">

                    <div class="accordion-body accordion-body-nointend">

                        <div class="card-body mx-0 p-0">

                            <ul class="list-group list-group-flush text-center">

                                @* Ограничения по возрасту *@
                                <li class="list-group-item">

                                    <span class="@(Model.FilmIsFamilyFriendly ? "fs-5 text_shadow" : "d-none")">
                                        Нет
                                    </span>
                                    <span class="@(Model.FilmIsFamilyFriendly ? "d-none" : "fs-5 text_shadow")">
                                        Да
                                    </span>

                                    <br />

                                    <span class="fs-6 form-text text-success px-2">
