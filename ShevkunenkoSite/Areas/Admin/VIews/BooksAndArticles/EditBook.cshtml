@model BooksAndArticlesModel

@{
    string cssForLabel = "col-form-label text-primary fs-5 me-2";

    string cssForSpanUnderLabel = "fs-6 text-success";
}

@* Изменить данные книги (статьи) *@
<div id="editBookOrArticle" class="row mb-3 bg-secondary-subtle shadw">

    <h1 id="editBookOrArticleTegH1" class="col h2 text_shadow">

        Изменить данные @(Model.TypeOfText == "book" ? "книги" : "статьи")

    </h1>

</div>

@* Заголовок книги (статьи) *@
<p id="captionOfText" class="h2 text_shadow ">

    @Model.CaptionOfText

</p>

@* Id книги (статьи) *@
<p id="bookOrArticleId" class="fs-5 mb-3">

    <label asp-for="BooksAndArticlesModelId" class="@cssForLabel"></label>

    <br />

    <span class="text_shadow">
        @Model.BooksAndArticlesModelId
    </span>

    <br />

    <span class="@cssForSpanUnderLabel">
        идентификатор в базе данных (GUID)
    </span>

</p>

@* Форма изменения данных *@
<div id="formForEditBookOrArticle" class="row">

    <div id="formAdaptive" class="col-12 col-lg-8 mx-auto p-2">

        <form asp-area="Admin"
              asp-controller="BooksAndArticles"
              asp-action="EditBook"
              method="post"
              enctype="multipart/form-data">

            @* Скрытые поля формы *@
            <div id="hiddenInput">

                <input asp-for="BooksAndArticlesModelId" type="hidden" />

            </div>

            @* Все ошибки ввода данных *@
            <div id="errorsForAllInput">

                @if (Context.Request.Method == "POST")
                {
                    <div asp-validation-summary="All" class="text-danger border border-top-0 border-danger mb-3"></div>
                }

            </div>

            @* Данные по группам *@
            <div id="accordionEditArticle" class="accordion">

                @* Тип текста *@
                <div id="typeOfText" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «тип текста» *@
                    <h2 id="headingTextType" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#TextType"
                                aria-expanded="true"
                                aria-controls="TextType">

                            <span class="form-label fs-5">
                                Тип текста :
                            </span>

                        </button>

                    </h2>

                    <div id="TextType"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingTextType"
                         data-bs-parent="#accordionEditArticle">

                        <div id="typeOfTextAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            @* Блок выбора типа текста *@
                            <div id="rowLabelTypeOfText" class="row g-2 justify-content-center">

                                <div id="colLabelTypeOfText" class="col-auto">

                                    <label asp-for="TypeOfText" class="@cssForLabel"></label>

                                </div>

                                @* Выбор типа текста *@
                                <div id="selectTypeOfText"
                                     class="col-auto"
                                     aria-describedby="TypesOfTextInputHelpBlock">

                                    <select id="TypesOfText" asp-for="TypeOfText" class="form-select">

                                        @{
                                            for (int i = 0; i < Model.TypesOfText.Count(); i++)
                                            {
                                                <option value="@Model.TypesOfText[i]">

                                                    @Model.TypesOfText[i]

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>

                                <div id="TypesOfTextInputHelpBlock" class="col-12 justify-content-center">

                                    <span class="@cssForSpanUnderLabel">
                                        тип текста
                                    </span>
                                    <br class="d-md-none" />
                                    <span class="@cssForSpanUnderLabel text-danger">
                                        - обязательное поле
                                    </span>

                                </div>

                                @if (Context.Request.Method == "POST")
                                {
                                    <span asp-validation-for="TypesOfText" class="text-danger"></span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                @* Обложка для книги *@
                <div id="CoverForBookAccordionItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «Обложка для книги» *@
                    <h2 id="headingCoverForBook" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#CoverForBook"
                                aria-expanded="true"
                                aria-controls="CoverForBook">

                            <span class="form-label fs-5">
                                Обложка для книги :
                            </span>

                        </button>

                    </h2>

                    @* Выбрать обложку *@
                    <div id="CoverForBook"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingCoverForBook"
                         data-bs-parent="#accordionEditArticle">

                        <div id="CoverForBookAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <div id="labelCoverForBook">

                                <label asp-for="CoverForBookFormFile" class="@cssForLabel"></label>

                                @if (Context.Request.Method == "GET")
                                {
                                    @if (Model.ImageFileModel != null)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="ImageInfo"
                                           asp-action="DetailsImage"
                                           asp-route-imageid="@Model.ImageFileModelId"
                                           class="d-block mx-auto maxwidth300px shadw imageref"
                                           title="информация о картинке"
                                           onclick="this.target='_blank'">

                                            <vc:view-image image-id="@Model.ImageFileModelId"
                                                           css-class="w-100"
                                                           icon-type="webimage" />

                                        </a>

                                        @if (!string.IsNullOrEmpty(Model.ImageFileModel.WebImageFileName))
                                        {
                                            <p class="text_shadow my-2 fluid-font-size">

                                                @Model.ImageFileModel.ImagePath/@Model.ImageFileModel.WebImageFileName

                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text_shadow my-2 fluid-font-size">

                                                @Model.ImageFileModel.ImagePath/@Model.ImageFileModel.ImageFileName

                                            </p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-center fluid-font-size text-bg-danger">

                                            обложка для книги не выбрана

                                        </p>
                                    }
                                }

                                <hr class="w-50 mx-auto" />

                            </div>

                            <div id="inputCoverForBook">

                                <input asp-for="CoverForBookFormFile"
                                       id="CoverForBookFormFileInput"
                                       class="form-control mt-2 w-50 mx-auto"
                                       aria-describedby="CoverForBookFormFileInputHelpBlock" />

                                @if (Context.Request.Method == "POST")
                                {
                                    <span asp-validation-for="CoverForBookFormFile" class="text-danger"></span>
                                }

                                <div id="CoverForBookFormFileInputHelpBlock" class="form-text mt-3">

                                    <span class="@cssForSpanUnderLabel">
                                        выбрать файл обложки
                                    </span>

                                </div>

                                <hr class="w-50 mx-auto" />

                                <select asp-for="ImageFileModelId"
                                        asp-items="ViewBag.ImageFiles"
                                        class="d-flex col-12 col-sm-7 col-lg-6 mx-auto my-3">

                                    <option value="@Guid.Empty">

                                        Обложка не выбрана

                                    </option>

                                </select>


                                @if (Context.Request.Method == "POST")
                                {
                                    <span asp-validation-for="ImageFileModelId" class="text-danger"></span>
                                }

                                <div class="@cssForSpanUnderLabel">

                                    <span class="fs-6 text-success">
                                        выбрать обложку
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                @* Издатель книги (статьи) *@
                <div id="PublisherAccordionIem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «Издатель книги (статьи)» *@
                    <h2 id="headingPublisher" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#Publisher"
                                aria-expanded="true"
                                aria-controls="Publisher">

                            <span class="form-label fs-5">
                                Издатель текста :
                            </span>

                        </button>

                    </h2>

                    <div id="Publisher"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingPublisher"
                         data-bs-parent="#accordionEditArticle">

                        <div id="PublisherAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="Publisher" class="@cssForLabel"></label>

                            <input asp-for="Publisher"
                                   id="PublisherInput"
                                   class="text-center col-11 col-lg-6"
                                   aria-describedby="PublisherInputHelpBlock" />

                            <div id="PublisherInputHelpBlock" class="form-text">

                                <span class="@cssForSpanUnderLabel">
                                    издатель книги (статьи)
                                </span>

                            </div>

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="Publisher" class="text-danger"></span>
                            }

                        </div>

                    </div>

                </div>

                @*  Логотип книги (статьи) *@
                <div id="logoAccordionItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «логотип книги (статьи)» *@
                    <h2 id="headingLogo" class="accordion-header">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#Logo"
                                aria-expanded="true"
                                aria-controls="Logo">

                            <span class="form-label fs-5">
                                Логотип текста :
                            </span>

                        </button>

                    </h2>

                    <div id="Logo"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingLogo"
                         data-bs-parent="#accordionEditArticle">

                        @* Логотип книги (статьи) *@
                        <div id="logoAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="LogoOfArticleId" class="@cssForLabel"></label>

                            @if (Model.LogoOfArticle != null)
                            {
                                <a asp-area="Admin"
                                   asp-controller="ImageInfo"
                                   asp-action="DetailsImage"
                                   asp-route-imageid="@Model.LogoOfArticleId"
                                   class="d-block"
                                   title="информация о картинке"
                                   onclick="this.target='_blank'">

                                    <vc:view-image image-id="@Model.LogoOfArticleId"
                                                   css-class="w-100 maxwidth700px shadw imageref"
                                                   icon-type="webimage" />

                                </a>

                                @if (!string.IsNullOrEmpty(Model.LogoOfArticle.WebImageFileName))
                                {
                                    <p class="text_shadow my-2 fluid-font-size">

                                        @Model.LogoOfArticle.ImagePath/@Model.LogoOfArticle.WebImageFileName

                                    </p>
                                }
                                else
                                {
                                    <p class="text_shadow mt-2 fluid-font-size">

                                        @Model.LogoOfArticle.ImagePath/@Model.LogoOfArticle.ImageFileName

                                    </p>
                                }
                            }
                            else
                            {
                                <p class="text-center fluid-font-size text-bg-danger">

                                    логотип для статьи не задан

                                </p>
                            }

                            <hr class="w-50 mx-auto" />

                            <input asp-for="LogoOfArticleFormFile"
                                   id="LogoOfArticleFormFileInput"
                                   class="form-control mt-2 w-50 mx-auto"
                                   aria-describedby="LogoOfArticleFormFileInputHelpBlock" />

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="LogoOfArticleFormFile" class="text-danger"></span>
                            }

                            <div id="LogoOfArticleFormFileInputHelpBlock" class="form-text mt-3">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать логотип
                                </span>

                            </div>

                            <hr class="w-50 mx-auto" />

                            <select asp-for="LogoOfArticleId"
                                    asp-items="ViewBag.ImageFiles"
                                    class="d-flex col-12 col-sm-7 col-lg-6 mx-auto my-3">

                                <option value="@Guid.Empty">

                                    Логотип не выбран

                                </option>

                            </select>

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="LogoOfArticleId" class="text-danger"></span>
                            }

                            <div class="form-text">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать логотип
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                @*  Скан книги (статьи) *@
                <div id="scanAccordionItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «скан книги (статьи)» *@
                    <h2 id="headingScan" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button" data-bs-toggle="collapse"
                                data-bs-target="#Scan"
                                aria-expanded="true"
                                aria-controls="Scan">

                            <span class="form-label fs-5">
                                Скан текста :
                            </span>

                        </button>

                    </h2>

                    <div id="Scan"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingScan"
                         data-bs-parent="#accordionEditArticle">

                        <div id="scanAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="ScanOfArticleId" class="@cssForLabel"></label>

                            @if (Model.ScanOfArticleId != null)
                            {
                                <a asp-area="Admin"
                                   asp-controller="ImageInfo"
                                   asp-action="DetailsImage"
                                   asp-route-imageid="@Model.ScanOfArticleId"
                                   class="d-block"
                                   title="скан текста"
                                   onclick="this.target='_blank'">

                                    <vc:view-image image-id="@Model.ScanOfArticleId"
                                                   css-class="w-100 maxwidth700px shadw imageref"
                                                   icon-type="webimage" />

                                </a>

                                @if (Model.ScanOfArticle != null)
                                {
                                    @if (!string.IsNullOrEmpty(Model.ScanOfArticle.WebImageFileName))
                                    {
                                        <p class="text_shadow my-2 fluid-font-size">

                                            @Model..ScanOfArticle.ImagePath/@Model.ScanOfArticle.WebImageFileName

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text_shadow mt-2 fluid-font-size">

                                            @Model.ScanOfArticle.ImagePath/@Model.ScanOfArticle.ImageFileName

                                        </p>
                                    }
                                }
                                else
                                {
                                    <p class="text-center fluid-font-size text-bg-danger">

                                        скан для статьи не задан

                                    </p>
                                }
                            }
                            else
                            {
                                <p class="text-center fluid-font-size text-bg-danger">

                                    скан для статьи не задан

                                </p>
                            }

                            <hr class="w-50 mx-auto" />

                            <input asp-for="ScanOfArticleFormFile"
                                   id="ScanOfArticleFormFileInput"
                                   class="form-control mt-2 w-50 mx-auto"
                                   aria-describedby="ScanOfArticleFormFileInputHelpBlock" />

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="ScanOfArticleFormFile" class="text-danger"></span>
                            }

                            <div id="ScanOfArticleFormFileInputHelpBlock" class="form-text mt-3">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать скан
                                </span>

                            </div>

                            <hr class="w-50 mx-auto" />

                            <select asp-for="ScanOfArticleId"
                                    asp-items="ViewBag.ImageFiles"
                                    class="d-flex col-12 col-sm-7 col-lg-6 mx-auto my-3">

                                <option value="@Guid.Empty">

                                    Скан не выбран

                                </option>

                            </select>

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="ScanOfArticleId" class="text-danger"></span>
                            }

                            <div class="form-text">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать скан
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                @*  Видео - movie для книги (статьи) *@
                <div id="videoAccordionItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «видео связанное с книгой (статьёй)» *@
                    <h2 id="headingVideoForBookOrArticle" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#VideoForBookOrArticle"
                                aria-expanded="true"
                                aria-controls="VideoForBookOrArticle">

                            <span class="form-label fs-5">
                                Видео для текста :
                            </span>

                        </button>

                    </h2>

                    <div id="VideoForBookOrArticle"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingVideoForBookOrArticle"
                         data-bs-parent="#accordionEditArticle">

                        <div id="videoAccordioBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="VideoForBookOrArticleId" class="@cssForLabel"></label>

                            @if (Model.VideoForBookOrArticle != null)
                            {
                                <a asp-area="Admin"
                                   asp-controller="MovieInfo"
                                   asp-action="DetailsMovie"
                                   asp-route-movieid="@Model.VideoForBookOrArticle.MovieFileModelId"
                                   class="d-block"
                                   title="информация о фильме"
                                   onclick="this.target='_blank'">

                                    <vc:view-image image-id="@Model.VideoForBookOrArticle.ImageFileModelId"
                                                   css-class="w-100 mx-auto maxwidth300px shadw imageref"
                                                   icon-type="webimage" />

                                </a>
                            }
                            else
                            {
                                <p class="text-center fluid-font-size text-bg-danger">

                                    видео не задано

                                </p>
                            }

                            <input asp-for="VideoForBookOrArticleFormFile"
                                   id="VideoForBookOrArticleFormFileInput"
                                   class="form-control mt-4 w-50 mx-auto"
                                   aria-describedby="VideoForBookOrArticleFormFileInputHelpBlock" />

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="VideoForBookOrArticleFormFile" class="text-danger"></span>
                            }

                            <div id="VideoForBookOrArticleFormFileInputHelpBlock" class="form-text mt-1">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать файл видео
                                </span>

                            </div>

                            <select asp-for="VideoForBookOrArticleId"
                                    asp-items="ViewBag.VideoFiles"
                                    class="d-flex col-12 col-sm-7 col-lg-6 mx-auto mt-4">

                                <option value="@Guid.Empty">

                                    Видео не выбрано

                                </option>

                            </select>

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="VideoForBookOrArticleId" class="text-danger"></span>
                            }

                            <div class="form-text mt-1">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать видео
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                @*  Видео - film по книге (статье) *@
                <div id="filmAccordionItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «фильм по книге (статье)» *@
                    <h2 id="headingFilmForBookOrArticle" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#FilmForBookOrArticle"
                                aria-expanded="true"
                                aria-controls="FilmForBookOrArticle">

                            <span class="form-label fs-5">
                                Фильм для текста :
                            </span>

                        </button>

                    </h2>

                    <div id="FilmForBookOrArticle"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingFilmForBookOrArticle"
                         data-bs-parent="#accordionEditArticle">

                        <div id="filmAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="FilmForBookOrArticleId" class="@cssForLabel"></label>

                            @if (Model.FilmForBookOrArticle != null)
                            {
                                <a asp-area="Admin"
                                   asp-controller="Films"
                                   asp-action="DetailsFilm"
                                   asp-route-filmid="@Model.FilmForBookOrArticle.FilmFileModelId"
                                   class="d-block"
                                   title="информация о фильме"
                                   onclick="this.target='_blank'">

                                    <vc:view-image image-id="@Model.FilmForBookOrArticle.FilmImageId"
                                                   css-class="w-100 mx-auto maxwidth300px shadw imageref"
                                                   icon-type="webimage" />

                                </a>
                            }
                            else
                            {
                                <p class="text-center fluid-font-size text-bg-danger">

                                    видео не задано

                                </p>
                            }

                            <input asp-for="FilmForBookOrArticleFormFile"
                                   id="FilmForBookOrArticleFormFileInput"
                                   class="form-control mt-4 w-50 mx-auto"
                                   aria-describedby="FilmForBookOrArticleFormFileInputHelpBlock" />

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="FilmForBookOrArticleFormFile" class="text-danger"></span>
                            }

                            <div id="FilmForBookOrArticleFormFileInputHelpBlock" class="form-text mt-1">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать файл фильма
                                </span>

                            </div>

                            <select asp-for="FilmForBookOrArticleId"
                                    asp-items="ViewBag.FilmFiles"
                                    class="d-flex col-12 col-sm-7 col-lg-6 mx-auto mt-3">

                                <option value="@Guid.Empty">

                                    Видео не выбрано

                                </option>

                            </select>

                            @if (Context.Request.Method == "POST")
                            {
                                <span asp-validation-for="FilmForBookOrArticleId" class="text-danger"></span>
                            }

                            <div class="form-text mt-1">

                                <span class="@cssForSpanUnderLabel">
                                    выбрать фильм
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                @*  Ссылка на статью (издателя) *@
                <div id="refAccordioItem" class="accordion-item mt-2 shadw">

                    @* Заголовок группы «ссылка на статью (издателя)» *@
                    <h2 id="headingUrlOfArticle" class="accordion-header shadw">

                        <button class="accordion-button collapsed py-0 stranicy"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#UrlOfArticle"
                                aria-expanded="true"
                                aria-controls="UrlOfArticle">

                            <span class="form-label fs-5">
                                Ссылка на текст :
                            </span>

                        </button>

                    </h2>

                    <div id="UrlOfArticle"
                         class="accordion-collapse collapse"
                         aria-labelledby="headingUrlOfArticle"
                         data-bs-parent="#accordionEditArticle">

                        <div id="refAccordionBody" class="accordion-body accordion-body-nointend text-center">

                            <label asp-for="UrlOfArticle" class="@cssForLabel"></label>

                            @if (Model.UrlOfArticle != null)
                            {
                                <div class="col-12 fs-5 text-center pb-3">

                                    <a class="text-black text_shadow"
                                       href="@Model.UrlOfArticle"
                                       nClick="this.target='_blank'">

                                        @Model.UrlOfArticle

                                    </a>

                                </div>
                            }
                            else
                            {
                                <p class="text-center fluid-font-size text-bg-danger">

                                    ссылка на статью не задана

                                </p>
                            }

