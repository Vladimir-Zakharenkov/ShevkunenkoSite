@model EditImageViewModel

@{
    string cssForLabel = "col-form-label text-primary fs-5 me-2 mb-2 py-0";
    string cssForHelpBlock = "fs-6 form-text text-success mt-2";
}

<partial name="_HeadingPartial"
         model='("Изменить данные картинки", "h1")' />

<div class="row">

    <div class="col col-lg-9 col-xl-7 col-xxl-6 d-block mx-auto px-2">

        <div class="card p-2">

            @* Сообщение о всех ошибках ввода данных *@
            <div>

                @if (Context.Request.Method == "POST")
                {
                    <div asp-validation-summary="All" class="text-danger border border-top-0 border-danger mb-3"></div>
                }

            </div>

            <form method="post" enctype="multipart/form-data"
                  asp-area="Admin"
                  asp-controller="ImageInfo"
                  asp-action="EditImage">

                @* Скрытые поля *@
                <input asp-for="EditImage.ImageFileModelId" type="hidden" />

                @* Заголовок картинки *@
                <div class="mb-4">

                    <label asp-for="EditImage.ImageCaption"
                           class="@cssForLabel">
                    </label>

                    <input asp-for="EditImage.ImageCaption"
                           class="form-control text-center mx-auto w-75"
                           aria-describedby="ImageCaptionInputHelpBlock" />

                    <div id="ImageCaptionInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            «caption» и «name» для Microdata -
                        </span>

                        <br class="d-sm-none" />

                        <span class="text-danger">
                            обязательное поле
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="EditImage.ImageCaption" class="text-danger"></span>
                    }

                </div>

                @* Описание картинки *@
                <div class="mb-4">

                    <label asp-for="EditImage.ImageDescription"
                           class="@cssForLabel">
                    </label>

                    <textarea asp-for="EditImage.ImageDescription"
                              class="form-control mx-auto w-75"
                              rows="3"
                              aria-describedby="ImageDescriptionInputHelpBlock">
                    </textarea>

                    <div id="ImageDescriptionInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            «description» для Microdata -
                        </span>

                        <br class="d-sm-none" />

                        <span class="text-danger">
                            обязательное поле
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="EditImage.ImageDescription" class="text-danger"></span>
                    }

                </div>

                @* «alt» и «title» для картинки *@
                <div class="mb-4">

                    <label asp-for="EditImage.ImageAltTitle"
                           class="@cssForLabel">
                    </label>

                    <input asp-for="EditImage.ImageAltTitle"
                           class="form-control mx-auto w-50"
                           aria-describedby="ImageAltTitleInputHelpBlock" />

                    <div id="ImageAltTitleInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            «alt» и «title» для тега «img» -
                        </span>

                        <br class="d-sm-none" />

                        <span class="text-danger">
                            обязательное поле
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="EditImage.ImageAltTitle" class="text-danger"></span>
                    }

                </div>

                @* Фильтр поиска картинки в базе данных *@
                <div class="mb-4">

                    <label asp-for="EditImage.SearchFilter"
                           class="@cssForLabel">
                    </label>

                    @* Текущие фильтры для картинки *@
                    <div class="maxwidthcontent mx-auto justify-content-lg-start mb-3">

                        @foreach (var tag in Model.EditImage.SearchFilter.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p class="fs-5 text-start text_shadow">

                                # @tag

                            </p>
                        }

                    </div>

                    <textarea asp-for="EditImage.SearchFilter"
                              class="form-control"
                              rows="6"
                              aria-describedby="SearchFilterInputHelpBlock">
                    </textarea>

                    <div id="SearchFilterInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            фильтры поиска картинки
                        </span>

                        <br />

                        <span>
                            (ввод через запятую)
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="EditImage.SearchFilter" class="text-danger"></span>
                    }

                </div>

                @* Порядок сортировки картинки *@
                <div class="row g-2 justify-content-center mb-4">

                    <div class="col-auto">

                        <label asp-for="EditImage.SortOfPicture"
                               class="@cssForLabel">
                        </label>

                    </div>

                    <div class="col-auto">

                        <input asp-for="EditImage.SortOfPicture"
                               class="form-control text-center"
                               aria-describedby="SortOfPictureInputHelpBlock" />

                    </div>

                    <div id="SortOfPictureInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            индекс сортировки
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="EditImage.SortOfPicture" class="text-danger"></span>
                    }

                </div>

                @* Каталог картинки *@
                <div class="mb-4">

                    @* Текущий каталог *@
                    <p class="mb-3">

                        <span class="@cssForLabel">
                            Текущий каталог:
                        </span>

                        <br class="d-sm-none" />

                        <span class="fs-5 text_shadow">
                            @Model.EditImage.ImagePath
                        </span>

                    </p>

                    <label asp-for="EditImage.ImagePath"
                           class="@cssForLabel">
                    </label>

                    <select asp-for="EditImage.ImagePath"
                            asp-items="Model.ImageDirectories"
                            class="w-50"
                            aria-describedby="ImagePathInputHelpBlock">

                        @if (!Model.ImageDirectories.Any(d => d.Value == Model.EditImage.ImagePath))
                        {
                            <option value="@Model.EditImage.ImagePath">
                                @System.IO.Path.GetFileName(Model.EditImage.ImagePath) (текущий)
                            </option>
                        }

                    </select>

                    <div id="ImagePathInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            выбрать каталог картинки
                        </span>

                        <br class="d-sm-none" />

                        <span>
                            (в каталоге «images»)
                        </span>

                    </div>

                </div>

                @* Новый каталог для картинки *@
                <div class="row g-2 justify-content-center">

                    <div class="col-auto">

                        <label asp-for="NewImagePath"
                               class="@cssForLabel">
                        </label>

                    </div>

                    <div class="col-auto">

                        <input asp-for="NewImagePath"
                               class="form-control text-center"
                               aria-describedby="NewImagePathInputHelpBlock" />

                    </div>

                    <div id="NewImagePathInputHelpBlock"
                         class="@cssForHelpBlock">

                        <span>
                            добавить новый каталог
                        </span>

                        <br class="d-sm-none" />

                        <span>
                            (в каталог «images»)
                        </span>

                    </div>

                    @if (Context.Request.Method == "POST")
                    {
                        <span asp-validation-for="NewImagePath" class="text-danger"></span>
                    }

                </div>

                @* Выбор картинок *@
                <div class="accordion p-3" id="accordionEditImage">

                    @* Выбор картинок WEBP*@
                    <div class="accordion-item mb-3 block-shadow">

                        <h2 id="webpHeading" class="accordion-header block-shadow">

                            <button class="accordion-button collapsed py-0 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#WebpImage"
                                    aria-expanded="false"
                                    aria-controls="WebpImage">

                                <span class="form-label fs-5">
                                    Формат WEBP :
                                </span>

                            </button>

                        </h2>

                        <div id="WebpImage"
                             class="accordion-collapse collapse"
                             aria-labelledby="webpHeading"
                             data-bs-parent="#accordionEditImage">

                            <div class="accordion-body text-indent-0 text-center">

                                @* Картинка WebHD *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.WebImageHDFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3">

                                            картинка WebHD отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.WebImageHDWidth px x @Model.EditImage.WebImageHDHeight px) / Размер @Model.EditImage.WebImageHDFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class=""
                                                       icon-type="webhd" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.WebImageHDFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center mb-3">

                                        <div class="col-auto">

                                            <label asp-for="WebImageHDFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebImageHDFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebImageHDFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebImageHDFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                        @if (Context.Request.Method == "POST")
                                        {
                                            <span asp-validation-for="WebImageHDFormFile" class="text-danger"></span>
                                        }

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.WebImageHDFileName))
                                    {
                                        <label asp-for="DeleteWebImageHD"
                                               class="@cssForLabel">
                                        </label>

                                        <input asp-for="DeleteWebImageHD"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="WebImageHDFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Картинка Web *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.WebImageFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3">

                                            картинка WebImage отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.WebImageWidth px x @Model.EditImage.WebImageHeight px) / Размер @Model.EditImage.WebImageFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class="maxwidth600px"
                                                       icon-type="webimage" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.WebImageFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="WebImageFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebImageFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebImageFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebImageFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="WebImageFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка Web300 *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.WebIconFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3">

                                            иконка WebIcon300 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.WebIconWidth px x @Model.EditImage.WebIconHeight px) / Размер @Model.EditImage.WebIconFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class="maxwidth300px"
                                                       icon-type="webicon300" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.WebIconFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="WebIconFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIconFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIconFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIconFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="WebIconFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка Web200 *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.WebIcon200FileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3">

                                            иконка WebIcon200 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.WebIcon200Width px x @Model.EditImage.WebIcon200Height px) / Размер @Model.EditImage.WebIcon200FileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class="maxwidth200px"
                                                       icon-type="webicon200" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.WebIcon200FileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="WebIcon200FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIcon200FormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIcon200FormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIcon200FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="WebIcon200FormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка Web100 *@
                                <div>

                                    @if (string.IsNullOrEmpty(Model.EditImage.WebIcon100FileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3 fw-bolder">

                                            иконка WebIcon100 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.WebIcon100Width px x @Model.EditImage.WebIcon100Height px) / Размер @Model.EditImage.WebIcon100FileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class="maxwidth100px"
                                                       icon-type="webicon100" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.WebIcon100FileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="WebIcon100FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIcon100FormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIcon100FormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIcon100FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="WebIcon100FormFile" class="text-danger"></span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Выбор картинок PNG*@
                    <div class="accordion-item block-shadow">

                        <h2 id="pngHeading" class="accordion-header">

                            <button class="accordion-button collapsed py-0 stranicy"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#PngImage"
                                    aria-expanded="false"
                                    aria-controls="PngImage">

                                <span class="form-label fs-5">
                                    Формат PNG :
                                </span>

                            </button>

                        </h2>

                        <div id="PngImage"
                             class="accordion-collapse collapse"
                             aria-labelledby="pngHeading"
                             data-bs-parent="#accordionEditImage">

                            <div class="accordion-body text-indent-0 text-center">

                                @* Картинка HD *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.ImageHDFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="webimage" />

                                        <p class="fs-5 text-danger my-3">

                                            картинка HD отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.ImageHDWidth px x @Model.EditImage.ImageHDHeight px) / Размер @Model.EditImage.ImageHDFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class=""
                                                       icon-type="hd" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.ImageHDFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="ImageHDFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="ImageHDFormFile"
                                                   class="form-control"
                                                   aria-describedby="ImageHDFormFileInputHelpBlock" />

                                        </div>

                                        <div id="ImageHDFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.ImageHDFileName))
                                    {
                                        <label asp-for="DeleteImageHD"
                                               class="@cssForLabel">
                                        </label>

                                        <input asp-for="DeleteImageHD"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="ImageHDFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Картинка 720 *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.ImageFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class="maxwidth600px"
                                                       icon-type="image" />

                                        <p class="fs-5 text-danger my-3">

                                            картинка отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.ImageWidth px x @Model.EditImage.ImageHeight px) / Размер @Model.EditImage.ImageFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class="maxwidth600px"
                                                       icon-type="image" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.ImageFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="ImageFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="ImageFormFile"
                                                   class="form-control"
                                                   aria-describedby="ImageFormFileInputHelpBlock" />

                                        </div>

                                        <div id="ImageFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.ImageFileName))
                                    {
                                        <label asp-for="DeleteImage"
                                               class="@cssForLabel">
                                        </label>

                                        <input asp-for="DeleteImage"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="ImageFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка 300 *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.IconFileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="icon300" />

                                        <p class="fs-5 text-danger my-3">

                                            иконка icon300 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.IconWidth px x @Model.EditImage.IconHeight px) / Размер @Model.EditImage.IconFileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class=""
                                                       icon-type="icon300" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.IconFileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="IconFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="IconFormFile"
                                                   class="form-control"
                                                   aria-describedby="IconFormFileInputHelpBlock" />

                                        </div>

                                        <div id="IconFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.IconFileName))
                                    {
                                        <label asp-for="DeleteIcon"
                                               class="@cssForLabel">
                                        </label>

                                        <input asp-for="DeleteIcon"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="IconFormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка 200 *@
                                <div class="mb-3">

                                    @if (string.IsNullOrEmpty(Model.EditImage.Icon200FileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="icon200" />

                                        <p class="fs-5 text-danger my-3">

                                            иконка icon200 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.Icon200Width px x @Model.EditImage.Icon200Height px) / Размер @Model.EditImage.Icon200FileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class=""
                                                       icon-type="icon200" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.Icon200FileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="Icon200FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="Icon200FormFile"
                                                   class="form-control"
                                                   aria-describedby="Icon200FormFileInputHelpBlock" />

                                        </div>

                                        <div id="Icon200FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.Icon200FileName))
                                    {
                                        <label asp-for="DeleteIcon200"
                                               class="col-form-label text-danger fs-5 me-2">
                                        </label>

                                        <input asp-for="DeleteIcon200"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="Icon200FormFile" class="text-danger"></span>
                                    }

                                </div>

                                @* Иконка 100 *@
                                <div>

                                    @if (string.IsNullOrEmpty(Model.EditImage.Icon100FileName))
                                    {
                                        <vc:view-image image-id="@DataConfig.NoImage"
                                                       css-class=""
                                                       icon-type="icon100" />

                                        <p class="fs-5 text-danger my-3">

                                            иконка icon100 отсутствует

                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-success fs-6 mb-2 mt-3">

                                            Картинка (@Model.EditImage.Icon100Width px x @Model.EditImage.Icon100Height px) / Размер @Model.EditImage.Icon100FileSize bytes

                                        </p>

                                        <vc:view-image image-id="@Model.EditImage.ImageFileModelId"
                                                       css-class=""
                                                       icon-type="icon100" />

                                        <p class="text_shadow fs-5 my-3">

                                            File: @Model.EditImage.ImagePath/@Model.EditImage.Icon100FileName

                                        </p>
                                    }

                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="Icon100FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="Icon100FormFile"
                                                   class="form-control"
                                                   aria-describedby="Icon100FormFileInputHelpBlock" />

                                        </div>

                                        <div id="Icon100FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл
                                            </span>

                                        </div>

                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.EditImage.Icon100FileName))
                                    {
                                        <label asp-for="DeleteIcon100"
                                               class="@cssForLabel">
                                        </label>

                                        <input asp-for="DeleteIcon100"
                                               class="form-check-input fs-5 align-text-bottom" />
                                    }

                                    @if (Context.Request.Method == "POST")
                                    {
                                        <span asp-validation-for="Icon100FormFile" class="text-danger"></span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                @* Сохранить - Отменить изменения *@
                <div class="card-footer p-0 mt-2 border-0">

                    <button type="submit"
                            class="btn btn-outline-success m-2 text-center minwidth100px block-shadow"
                            title="сохранить изменения">

                        Сохранить

                    </button>

                    <a asp-area="Admin"
                       asp-controller="ImageInfo"
                       asp-action="Index"
                       asp-route-pageCard="false"
                       class="btn btn-outline-danger m-2 minwidth100px block-shadow"
                       title="отменить изменения">

                        Отмена

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>