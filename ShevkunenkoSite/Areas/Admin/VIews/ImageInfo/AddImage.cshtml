@model EditImageViewModel

@{
    string cssForLabel = "col-form-label text-primary fs-5 me-2 mb-2 py-0";
    string cssForHelpBlock = "fs-6 form-text text-success mt-2";
}

<partial name="_HeadingPartial"
         model='("Добавить картинку", "h1")' />

<div class="row">

    <div class="col col-lg-9 col-xl-7 col-xxl-6 mx-auto px-2 border border-1">

        <div class="p-2 mt-4">

            <div class="mx-0 p-0">

                <form method="post" enctype="multipart/form-data"
                      asp-area="Admin"
                      asp-controller="ImageInfo"
                      asp-action="AddImage">

                    @* Все ошибки ввода данных *@
                    @if (Context.Request.Method == "POST")
                    {
                        <div asp-validation-summary="All"
                             class="text-danger border border-top-0 border-danger mb-3">
                        </div>
                    }

                    @* Заголовок картинки *@
                    <div class="mb-4">

                        <label asp-for="EditImage.ImageCaption"
                               class="@cssForLabel">
                        </label>

                        <input asp-for="EditImage.ImageCaption"
                               class="form-control text-center mx-auto w-75"
                               aria-describedby="ImageCaptionInputHelpBlock" />

                        <div id="ImageCaptionInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                «caption» и «name» для Microdata -
                            </span>

                            <br class="d-md-none" />

                            <span class="text-danger">
                                обязательное поле
                            </span>

                        </div>

                    </div>

                    @* Описание картинки *@
                    <div class="mb-4">

                        <label asp-for="EditImage.ImageDescription"
                               class="@cssForLabel">
                        </label>

                        <textarea asp-for="EditImage.ImageDescription"
                                  class="form-control mx-auto w-75"
                                  rows="3"
                                  aria-describedby="ImageDescriptionInputHelpBlock">
                        </textarea>

                        <div id="ImageDescriptionInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                «description» для Microdata  -
                            </span>

                            <br class="d-md-none" />

                            <span class="text-danger">
                                обязательное поле
                            </span>

                            <br />

                            <span>
                                (по умолчанию равно «caption»)
                            </span>

                        </div>

                    </div>

                    @* «alt» и «title» для картинки *@
                    <div class="mb-4">

                        <label asp-for="EditImage.ImageAltTitle"
                               class="@cssForLabel">
                        </label>

                        <input asp-for="EditImage.ImageAltTitle"
                               class="form-control mx-auto w-50"
                               aria-describedby="ImageAltTitleInputHelpBlock" />

                        <div id="ImageAltTitleInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                «alt» и «title» для тэга «img»
                            </span>

                            <br />

                            <span>
                                (по умолчанию равно «caption»)
                            </span>

                        </div>

                    </div>

                    @* Фильтр поиска картинки в базе данных *@
                    <div class="mb-4">

                        <label asp-for="EditImage.SearchFilter"
                               class="@cssForLabel">
                        </label>

                        <textarea asp-for="EditImage.SearchFilter"
                                  class="form-control mx-auto w-75"
                                  rows="2"
                                  aria-describedby="SearchFilterInputHelpBlock">
                        </textarea>

                        <div id="SearchFilterInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                фильтры поиска картинки
                            </span>

                            <br />

                            <span>
                                (ввод через запятую)
                            </span>

                        </div>

                    </div>

                    @* Порядок сортировки картинки *@
                    <div class="row g-2 justify-content-center mb-4">

                        <div class="col-auto">

                            <label asp-for="EditImage.SortOfPicture"
                                   class="@cssForLabel">
                            </label>

                        </div>

                        <div class="col-auto">

                            <input asp-for="EditImage.SortOfPicture"
                                   class="form-control text-center maxwidth100px"
                                   aria-describedby="SortOfPictureInputHelpBlock" />

                        </div>

                        <div id="SortOfPictureInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                индекс сортировки
                            </span>

                        </div>

                    </div>

                    @* Каталог картинки *@
                    <div class="mb-4">

                        <label asp-for="EditImage.ImagePath"
                               class="@cssForLabel">
                        </label>

                        <select asp-for="EditImage.ImagePath"
                                asp-items="Model.ImageDirectories"
                                class="form-select w-50 mx-auto"
                                aria-describedby="ImagePathInputHelpBlock">
                        </select>

                        <div id="ImagePathInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                выбрать каталог картинки
                            </span>

                            <br />

                            <span>
                                (по умолчанию «images»)
                            </span>

                        </div>

                    </div>

                    @* Новый каталог для картинки *@
                    <div class="row g-2 justify-content-center mb-3">

                        <div class="col-auto">

                            <label asp-for="NewImagePath"
                                   class="@cssForLabel">

                            </label>

                        </div>

                        <div class="col-auto">

                            <input asp-for="NewImagePath"
                                   class="form-control text-center"
                                   aria-describedby="NewImagePathInputHelpBlock" />

                        </div>

                        <div id="NewImagePathInputHelpBlock"
                             class="@cssForHelpBlock">

                            <span>
                                новый каталог для картинки
                            </span>

                        </div>

                    </div>

                    @* Выбор картинок *@
                    <div id="accordionAddImage" class="accordion">

                        @* Выбор картинок WEBP*@
                        <div class="accordion-item mb-3 block-shadow">

                            <h2 id="webHeadingDescription" class="accordion-header block-shadow">

                                <button class="accordion-button collapsed py-0 stranicy"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#WebpImage"
                                        aria-expanded="false"
                                        aria-controls="WebpImage">

                                    <span class="form-label fs-5">
                                        Формат WEBP :
                                    </span>

                                </button>

                            </h2>

                            <div id="WebpImage"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="webHeadingDescription"
                                 data-bs-parent="#accordionAddImage">

                                <div class="accordion-body text-indent-0 text-center">

                                    @* Выбор картинки HD WEBP *@
                                    <div class="row g-2 justify-content-center mt-2 mb-4">

                                        <div class="col-auto">

                                            <label asp-for="WebImageHDFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebImageHDFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebImageHDFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebImageHDFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл WEBP - HD
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки WEBP 720 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="WebImageFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebImageFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebImageFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebImageFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл WEBP - 720 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки WEBP 300 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="WebIconFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIconFormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIconFormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIconFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл WEBP - 300 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки WEBP 200 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="WebIcon200FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIcon200FormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIcon200FormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIcon200FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл WEBP - 200 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки WEBP 100 px *@
                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="WebIcon100FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="WebIcon100FormFile"
                                                   class="form-control"
                                                   aria-describedby="WebIcon100FormFileInputHelpBlock" />

                                        </div>

                                        <div id="WebIcon100FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл WEBP - 100 px
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        @* Выбор картинок PNG*@
                        <div class="accordion-item block-shadow">

                            <h2 id="pngHeadingDescription" class="accordion-header block-shadow">

                                <button class="accordion-button collapsed py-0 stranicy"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#PngImage"
                                        aria-expanded="false"
                                        aria-controls="PngImage">

                                    <span class="form-label fs-5">
                                        Формат PNG :
                                    </span>

                                </button>

                            </h2>

                            <div id="PngImage"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="pngHeadingDescription"
                                 data-bs-parent="#accordionAddImage">

                                <div class="accordion-body text-indent-0 text-center">

                                    @* Выбор картинки HD PNG *@
                                    <div class="row g-2 justify-content-center mt-2 mb-4">

                                        <div class="col-auto">

                                            <label asp-for="ImageHDFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="ImageHDFormFile"
                                                   class="form-control"
                                                   aria-describedby="ImageHDFormFileInputHelpBlock" />

                                        </div>

                                        <div id="ImageHDFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл PNG - HD
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки PNG 720 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="ImageFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="ImageFormFile"
                                                   class="form-control"
                                                   aria-describedby="ImageFormFileInputHelpBlock" />

                                        </div>

                                        <div id="ImageFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл PNG - 720 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки PNG 300 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="IconFormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="IconFormFile"
                                                   class="form-control"
                                                   aria-describedby="IconFormFileInputHelpBlock" />

                                        </div>

                                        <div id="IconFormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл PNG - 300 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки PNG 200 px *@
                                    <div class="row g-2 justify-content-center mb-4">

                                        <div class="col-auto">

                                            <label asp-for="Icon200FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="Icon200FormFile"
                                                   class="form-control"
                                                   aria-describedby="Icon200FormFileInputHelpBlock" />

                                        </div>

                                        <div id="Icon200FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл PNG - 200 px
                                            </span>

                                        </div>

                                    </div>

                                    @* Выбор картинки PNG 100 px *@
                                    <div class="row g-2 justify-content-center">

                                        <div class="col-auto">

                                            <label asp-for="Icon100FormFile"
                                                   class="@cssForLabel">
                                            </label>

                                        </div>

                                        <div class="col-auto">

                                            <input asp-for="Icon100FormFile"
                                                   class="form-control"
                                                   aria-describedby="Icon100FormFileInputHelpBlock" />

                                        </div>

                                        <div id="Icon100FormFileInputHelpBlock"
                                             class="@cssForHelpBlock">

                                            <span>
                                                выбрать файл PNG - 100 px
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    @* Сохранить картинку *@
                    <div class="card-footer p-0 mt-4 border-0">

                        <button type="submit"
                                class="btn btn-outline-success m-2 text-center minwidth100px block-shadow"
                                title="добавить картинку">

                            Добавить

                        </button>

                        <a asp-area="Admin"
                           asp-controller="ImageInfo"
                           asp-action="Index"
                           asp-route-pageCard="false"
                           class="btn btn-outline-danger m-2 block-shadow minwidth100px"
                           title="не сохранять">

                            Отмена

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script>

    document.addEventListener('DOMContentLoaded', function() {
        const newPath = document.getElementById('NewImagePath');
        const select = document.getElementById('EditImage_ImagePath');

        if (!newPath || !select) return;

        newPath.addEventListener('input', function() {
            if (this.value.trim() !== '') {
                select.value = '/images';  // или первое значение
            }
        });
    });

</script>