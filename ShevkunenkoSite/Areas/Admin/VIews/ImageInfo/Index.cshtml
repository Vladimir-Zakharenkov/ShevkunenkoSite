@model ItemsListViewModel

@{
    // Локальные функции Razor — уменьшают дублирование
    string PickPrimaryFileName(ImageFileModel img) =>
        string.IsNullOrEmpty(img.WebImageFileName) ? img.ImageFileName : img.WebImageFileName;

    string PickWidth(ImageFileModel img) =>
        (img.WebImageWidth > 0 ? img.WebImageWidth : img.ImageWidth).ToString();

    string PickHeight(ImageFileModel img) =>
        (img.WebImageHeight > 0 ? img.WebImageHeight : img.ImageHeight).ToString();
}

<partial name="_HeadingPartial"
         model='("Картинки сайта", "h1")' />

@* Значение строки поиска *@
<div>

    @if (!string.IsNullOrEmpty(Model.SearchString))
    {
        <div class="row mb-0">

            <p class="col-12 fs-3 text-primary">

                Поиск по строке:

                <span class="text-black text_shadow">
                    @Model.SearchString
                </span>

            </p>

        </div>
    }

</div>

@* Количество картинок *@
<div class="text-center mb-0">

    <p class="fs-3 text-primary mb-0">

        Количество изображений:&nbsp;

        <span class="text-black text_shadow">
            @Model.TotalItems
        </span>
    </p>

    <hr class="w-50 liniya" />

</div>

@* Кнопки «Добавить» - «Иконки» - Поиск картинок *@
<div class="row mb-4">

    @* Добавить картинку - Иконки картинок *@
    <div class="col-12 col-md-6 col-lg-4">

        <a asp-area="Admin"
           asp-controller="ImageInfo"
           asp-action="AddImage"
           class="btn btn-outline-danger block-shadow py-1 mt-2 me-3 minwidth100px"
           title="добавить картинку">
            Добавить
        </a>

        <a asp-area="Admin"
           asp-controller="ImageInfo"
           asp-action="Index"
           asp-route-searchString="@Model.SearchString"
           asp-route-pageCard="true"
           class="btn btn-outline-primary block-shadow py-1 mt-2 minwidth100px"
           title="иконки картинок">
            Иконки
        </a>

    </div>

    @* Поиск картинок *@
    <div class="col-12 col-md-6 col-lg-8 mb-2">

        <form method="get"
              asp-area="Admin"
              asp-controller="ImageInfo"
              asp-action="Index"
              class="text-center text-md-end mt-md-2">

            <input type="hidden" name="pageCard" value="false" />

            <input asp-for="SearchString"
                   class="d-inline-block align-middle mt-1 w-50"
                   type="text" />

            <input class="btn btn-outline-success block-shadow py-1 me-md-3"
                   type="submit"
                   value="Поиск"
                   title="поиск картинки" />

        </form>

    </div>

</div>

@* Таблица данных картинок *@
<div class="row">

    <div class="col m-1 block-shadow">

        <div class="table-responsive">

            <table class="table table-sm table-hover caption-top align-middle">

                <thead>

                    <tr class="table-secondary">

                        <th scope="col" class="text-start text-primary">FileName</th>
                        <th scope="col" class="text-start text-primary">ImageCaption</th>
                        <th scope="col" class="d-none d-xl-table-cell text-start text-success">WebHD</th>
                        <th scope="col" class="d-none d-xl-table-cell text-start text-success">WebImage</th>
                        <th scope="col" class="d-none d-xl-table-cell text-start text-success">WebIcon300</th>
                        <th scope="col" class="d-none d-xl-table-cell text-start text-success">WebIcon200</th>
                        <th scope="col" class="d-none d-xl-table-cell text-start text-success">WebIcon100</th>
                        <th scope="col" class="d-none d-lg-table-cell text-start">Width</th>
                        <th scope="col" class="d-none d-lg-table-cell text-start">Height</th>
                        <th scope="col"></th>
                        <th scope="col"></th>
                        <th scope="col"></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var image in Model.AllImageFiles)
                    {
                        // Флаги наличия Web-версий — вычисляются один раз
                        bool hasWebHD = !string.IsNullOrEmpty(image.WebImageHDFileName);
                        bool hasWebImage = !string.IsNullOrEmpty(image.WebImageFileName);
                        bool hasWebIcon300 = !string.IsNullOrEmpty(image.WebIconFileName);
                        bool hasWebIcon200 = !string.IsNullOrEmpty(image.WebIcon200FileName);
                        bool hasWebIcon100 = !string.IsNullOrEmpty(image.WebIcon100FileName);

                        <tr class="text-start">

                            <td scope="col" class="text-sm-start text_shadow">@PickPrimaryFileName(image)</td>

                            <td scope="col" class="text-start text_shadow">@image.ImageCaption</td>

                            <td scope="col" class="d-none d-xl-table-cell text-start @(hasWebHD ? "text-primary" : "text-danger")">
                                @(hasWebHD ? "Да" : "Нет")
                            </td>

                            <td scope="col" class="d-none d-xl-table-cell text-start @(hasWebImage ? "text-primary" : "text-danger")">
                                @(hasWebImage ? "Да" : "Нет")
                            </td>

                            <td scope="col" class="d-none d-xl-table-cell text-start @(hasWebIcon300 ? "text-primary" : "text-danger")">
                                @(hasWebIcon300 ? "Да" : "Нет")
                            </td>

                            <td scope="col" class="d-none d-xl-table-cell text-start @(hasWebIcon200 ? "text-primary" : "text-danger")">
                                @(hasWebIcon200 ? "Да" : "Нет")
                            </td>

                            <td scope="col" class="d-none d-xl-table-cell text-start @(hasWebIcon100 ? "text-primary" : "text-danger")">
                                @(hasWebIcon100 ? "Да" : "Нет")
                            </td>

                            <td scope="col" class="d-none d-lg-table-cell text-start">@PickWidth(image)</td>

                            <td scope="col" class="d-none d-lg-table-cell text-start">@PickHeight(image)</td>

                            <td scope="col" title="Информация">
                                <a class="btn btn-outline-primary py-1 px-1 block-shadow"
                                   asp-area="Admin"
                                   asp-controller="ImageInfo"
                                   asp-action="DetailsImage"
                                   asp-route-imageId="@image.ImageFileModelId"
                                   title="Информация о картинке">
                                    Info
                                </a>
                            </td>

                            <td scope="col" title="Редактировать">
                                <a class="btn btn-outline-success py-1 px-1 block-shadow"
                                   asp-area="Admin"
                                   asp-controller="ImageInfo"
                                   asp-action="EditImage"
                                   asp-route-imageId="@image.ImageFileModelId"
                                   title="Изменить картинку">
                                    Edit
                                </a>
                            </td>

                            <td scope="col" title="Удалить">
                                <a class="btn btn-outline-danger py-1 px-1 block-shadow"
                                   asp-area="Admin"
                                   asp-controller="ImageInfo"
                                   asp-action="DeleteImage"
                                   asp-route-imageId="@image.ImageFileModelId"
                                   title="Удалить картинку">
                                    Del
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@* Разбивка на страницы *@
@if (Model.TotalItems > DataConfig.NumberOfItemsPerPage)
{
    <div pagination="@Model"></div>
}